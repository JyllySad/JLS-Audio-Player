                                        <Grid>
                                            <Border Background="{TemplateBinding Background}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>

                                            <Thumb x:Name="PART_HeaderGripper" 
                           HorizontalAlignment="Right" 
                           Width="12" Margin="0,0,-6,0" 
                           Cursor="SizeWE">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsShowingFoldersOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>

                        </Style>
                        
                    </ListView.Resources>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding DisplayTrackNumber}"/>
                            <GridViewColumn Header="Title" Width="200" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Artist" Width="150" DisplayMemberBinding="{Binding Artist}"/>
                            <GridViewColumn Header="Album" Width="150" DisplayMemberBinding="{Binding Album}"/>
                            <GridViewColumn Header="Year" Width="60" DisplayMemberBinding="{Binding Year}"/>
                            <GridViewColumn Header="Genre" Width="110" DisplayMemberBinding="{Binding Genre}"/>
                            <GridViewColumn Header="Duration" Width="70" DisplayMemberBinding="{Binding Duration}"/>
                            <GridViewColumn Header="Depth" Width="55" DisplayMemberBinding="{Binding DisplayBitsPerSample}"/>
                            <GridViewColumn Header="Rate" Width="70" DisplayMemberBinding="{Binding SampleRate, StringFormat='{}{0} Hz'}"/>
                            <GridViewColumn Header="Bitrate" Width="70" DisplayMemberBinding="{Binding Bitrate, StringFormat='{}{0} kbps'}"/>
                            <GridViewColumn Header="Format" Width="60" DisplayMemberBinding="{Binding Extension}"/>
                            <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding DisplaySize}"/>
                            <GridViewColumn Header="Modified" Width="130" DisplayMemberBinding="{Binding DisplayModified}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Border Grid.Row="2" VerticalAlignment="Bottom" Height="60" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#001E1E1E" Offset="0.0" />
                                                <GradientStop Color="#1E1E1E" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>

            <Grid x:Name="AlbumViewContainer" Tag="{Binding CurrentFolderPath, NotifyOnTargetUpdated=True}" Background="#181818">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.40">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAlbumViewEnabled}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border CornerRadius="20,0,0,0" Background="#1E1E1E" ClipToBounds="True">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Panel.ZIndex="10" IsHitTestVisible="False" CornerRadius="20,0,0,0" Margin="0,0,0,-60">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{Binding DominantColor}" Offset="0.0" />
                                    <GradientStop Color="{Binding DominantColor}" Offset="0.58" />
                                    <GradientStop Color="#001E1E1E" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Grid.Row="0" Panel.ZIndex="11" Margin="20,10,20,5" x:Name="BrowserAlbumHeaderGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.Resources>
                                <Style x:Key="MinimalCircleActionBtnStyle" TargetType="ButtonBase">
                                    <Setter Property="Width" Value="32"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ButtonBase">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1" x:Name="BtnScale"/>
                                                    </Grid.RenderTransform>
                                                    <Ellipse x:Name="BaseEllipse" Fill="#26000000"/>
                                                    <Ellipse x:Name="HoverOverlay" Fill="#20FFFFFF" Opacity="0"/>
                                                    <Ellipse x:Name="PressedOverlay" Fill="#20000000" Opacity="0"/>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="PreviewMouseDown">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05"/>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.05"/>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.05"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="PreviewMouseUp">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter TargetName="BaseEllipse" Property="StrokeThickness" Value="1"/>
                                                        <Setter TargetName="BaseEllipse" Property="Stroke">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#44FFFFFF" Offset="0.0" />
                                                                    <GradientStop Color="#05FFFFFF" Offset="0.4" />
                                                                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>

                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                                    <Button Click="ToggleSidebarBtn_Click" Style="{StaticResource MinimalCircleActionBtnStyle}" Margin="0,0,10,0" ToolTip="Expand/Collapse Sidebar">
                                        <TextBlock x:Name="AlbumToggleSidebarIcon" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Button>

                                    <ToggleButton ToolTip="Save Album"
                      IsChecked="{Binding IsCurrentAlbumSaved, Mode=OneWay}"
                      Command="{Binding ToggleSaveAlbumCommand}"
                      Style="{StaticResource MinimalCircleActionBtnStyle}"
                      Visibility="{Binding IsHeartVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Margin="0,0,10,0">
                                        <TextBlock x:Name="HeartIcon" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xEB51;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentAlbumSaved}" Value="True">
                                                            <Setter Property="Text" Value="&#xEB52;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToggleButton>

                                    <Grid>
                                        <Button x:Name="OpenAlbumSearchBtn" 
        Click="OpenAlbumSearchBtn_Click" 
        Style="{StaticResource MinimalCircleActionBtnStyle}" 
        ToolTip="Search Files" 
        HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" FontWeight="Bold"/>
                                        </Button>

                                        <Border x:Name="AlbumSearchOverlay" CornerRadius="16" HorizontalAlignment="Left" Width="32" Height="32" Opacity="0" Visibility="Collapsed">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#26000000"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#442A2A2A" Offset="0.0"/>
                                                                        <GradientStop Color="#22151515" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#44FFFFFF" Offset="0.0" />
                                                                        <GradientStop Color="#05FFFFFF" Offset="0.4" />
                                                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.7" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                                <TextBox x:Name="AlbumSearchBox" Grid.Column="1" Text="{Binding SearchFileText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" CaretBrush="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" BorderThickness="0" Padding="4,6" VerticalContentAlignment="Center" FontWeight="SemiBold" LostFocus="AlbumSearchBox_LostFocus"/>

                                                <Button Grid.Column="2" Content="&#xE894;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" Click="CloseAlbumSearchBtn_Click" ToolTip="Close Search">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent" Padding="4">
                                                                <TextBlock x:Name="Icon" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.6">
                                                                    <TextBlock.RenderTransform>
                                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                                    </TextBlock.RenderTransform>
                                                                </TextBlock>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <EventTrigger RoutedEvent="MouseEnter">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                            <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.15"/>
                                                                            <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.15"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseLeave">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.15"/>
                                                                            <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                                                            <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding ShowFullCoverCommand}" VerticalAlignment="Top" Margin="0,-10,0,10" Width="220" Height="220" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>

                                                <Border CornerRadius="16" Margin="-15" Opacity="0.75" IsHitTestVisible="False">

                                                    <Border.CacheMode>
                                                        <BitmapCache EnableClearType="False" RenderAtScale="0.2"/>
                                                    </Border.CacheMode>

                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding AlbumCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <BlurEffect Radius="45" RenderingBias="Performance"/>
                                                    </Border.Effect>
                                                </Border>

                                                <Grid RenderTransformOrigin="0.5,0.5">

                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="CoverScale" ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>

                                                    <Border Background="Black" CornerRadius="8" Opacity="0.5" Margin="0,10,0,-10">

                                                        <Border.CacheMode>
                                                            <BitmapCache EnableClearType="False" RenderAtScale="0.5"/>
                                                        </Border.CacheMode>

                                                        <Border.Effect>
                                                            <BlurEffect Radius="30" RenderingBias="Performance"/>
                                                        </Border.Effect>
                                                    </Border>

                                                    <Grid>
                                                        <Border x:Name="PlaceholderBackground" Background="#181818" CornerRadius="8" Visibility="Collapsed">
                                                            <TextBlock Text="&#xE189;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border CornerRadius="8">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding AlbumCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Grid>

                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding AlbumCover}" Value="{x:Null}">
                                                    <Setter TargetName="PlaceholderBackground" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Grid Grid.Column="1" Margin="32,0,0,30" VerticalAlignment="Center">
                                    <StackPanel>

                                        <TextBlock Text="{Binding AlbumTitle}" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" FontSize="48" FontWeight="Black" Margin="0,0,45,6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding AlbumArtist}" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.85" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,18" IsHitTestVisible="False">

                                            <StackPanel.Resources>
                                                <Style x:Key="AlbumGlassOverlay" TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#55FFFFFF" Offset="0.0" />
                                                                        <GradientStop Color="#10FFFFFF" Offset="0.5" />
                                                                        <GradientStop Color="#15FFFFFF" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
                                                                        <GradientStop Color="#08FFFFFF" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Resources>

                                            <Grid Height="24" Margin="0,0,6,0" Visibility="{Binding IsAlbumFormatVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border CornerRadius="6" Background="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.15"/>
                                                <Border Style="{StaticResource AlbumGlassOverlay}"/>
                                                <TextBlock Text="{Binding AlbumFormat}" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.8" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Padding="8,0"/>
                                            </Grid>

                                            <Grid Height="24" Margin="0,0,6,0" Visibility="{Binding IsAlbumSampleRateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border CornerRadius="6" Background="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.15"/>
                                                <Border Style="{StaticResource AlbumGlassOverlay}"/>
                                                <TextBlock Text="{Binding AlbumSampleRate}" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.8" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Padding="8,0"/>
                                            </Grid>

                                            <Grid Height="24" Margin="0,0,0,0" Visibility="{Binding IsAlbumBitDepthVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border CornerRadius="6" Background="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.15"/>
                                                <Border Style="{StaticResource AlbumGlassOverlay}"/>
                                                <TextBlock Text="{Binding AlbumBitDepth}" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.8" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Padding="8,0"/>
                                            </Grid>

                                        </StackPanel>

                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding AlbumYear}" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.65" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AlbumDurationInfo}" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.60" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Grid>

                            </Grid>
                        </Grid>

                        <ListView x:Name="AlbumListView" Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
          Background="Transparent" BorderThickness="0"
          Margin="4,0,2,0" Padding="0"
          MouseDoubleClick="ListView_MouseDoubleClick"
          SelectionMode="Extended"
          PreviewMouseRightButtonUp="ListView_PreviewMouseRightButtonUp"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
