<Window x:Class="JLS.Views.VisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JLS Visualizer"
        WindowStyle="None" 
        WindowState="Maximized"
        Topmost="False"
        
        ResizeMode="NoResize"      ShowInTaskbar="False"
        AllowsTransparency="False" Background="#121212"       MouseMove="Window_MouseMove"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                     From="0" To="1" Duration="0:0:0.4" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="MainLayout" Background="{Binding DarkColor}" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                         From="0" To="1" Duration="0:0:0.4" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Rectangle x:Name="ProgressOverlay" 
                   HorizontalAlignment="Left" 
                   Fill="{Binding LightColor}" 
                   Opacity="0.08"
                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <Canvas x:Name="DrawCanvas" SizeChanged="DrawCanvas_SizeChanged" />
    </Grid>
</Window>