                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CancelScale" Storyboard.TargetProperty="ScaleX" To="1.25" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="CancelScale" Storyboard.TargetProperty="ScaleY" To="1.25" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
