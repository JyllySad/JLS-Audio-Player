                        </Grid>

                        <TextBlock Text="TITLE" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{Binding TrackName}" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="6,2" Visibility="{Binding IsEditingTags, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <TextBox Style="{StaticResource ModernTagTextBoxStyle}" Text="{Binding EditTrackName, UpdateSourceTrigger=PropertyChanged}" Background="#141416" Foreground="White" BorderBrush="#333" FontSize="18" FontWeight="SemiBold" Padding="4,2" TextWrapping="Wrap" Visibility="{Binding IsEditingTags, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <TextBlock Text="ARTIST" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{Binding ArtistName}" Foreground="#E0E0E0" FontSize="15" TextWrapping="Wrap" Margin="6,2" Visibility="{Binding IsEditingTags, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <TextBox Style="{StaticResource ModernTagTextBoxStyle}" Text="{Binding EditArtistName, UpdateSourceTrigger=PropertyChanged}" Background="#141416" Foreground="White" BorderBrush="#333" FontSize="15" Padding="4,2" TextWrapping="Wrap" Visibility="{Binding IsEditingTags, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <TextBlock Text="ALBUM" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{Binding AlbumName}" Foreground="#CCCCCC" FontSize="14" TextWrapping="Wrap" Margin="6,2" Visibility="{Binding IsEditingTags, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <TextBox Style="{StaticResource ModernTagTextBoxStyle}" Text="{Binding EditAlbumName, UpdateSourceTrigger=PropertyChanged}" Background="#141416" Foreground="White" BorderBrush="#333" FontSize="14" Padding="4,2" TextWrapping="Wrap" Visibility="{Binding IsEditingTags, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="GENRE" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Genre}" Foreground="#CCCCCC" FontSize="14" TextTrimming="CharacterEllipsis" Margin="6,2" Visibility="{Binding IsEditingTags, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <TextBox Style="{StaticResource ModernTagTextBoxStyle}" Text="{Binding EditGenre, UpdateSourceTrigger=PropertyChanged}" Background="#141416" Foreground="White" BorderBrush="#333" FontSize="14" Padding="4,2" Visibility="{Binding IsEditingTags, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>

                                <TextBlock Text="YEAR" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="{Binding TrackYear}" Foreground="#CCCCCC" FontSize="14" Margin="6,2" Visibility="{Binding IsEditingTags, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <TextBox Style="{StaticResource ModernTagTextBoxStyle}" Text="{Binding EditTrackYear, UpdateSourceTrigger=PropertyChanged}" Background="#141416" Foreground="White" BorderBrush="#333" FontSize="14" Padding="4,2" MaxLength="4" Visibility="{Binding IsEditingTags, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>

                                <TextBlock Text="TRACK NUMBER" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                <Grid>
                                    <TextBlock Text="{Binding TrackNumber}" Foreground="#CCCCCC" FontSize="14" Margin="6,2" Visibility="{Binding IsEditingTags, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <TextBox Style="{StaticResource ModernTagTextBoxStyle}" Text="{Binding EditTrackNumber, UpdateSourceTrigger=PropertyChanged}" Background="#141416" Foreground="White" BorderBrush="#333" FontSize="14" Padding="4,2" MaxLength="3" Visibility="{Binding IsEditingTags, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <TextBlock Text="TRACK COVER" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                <Grid x:Name="EditCoverGrid">

                                    <Border Width="100" Height="100" CornerRadius="8" Background="#141416"
        Visibility="{Binding IsEditingTags, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <Grid>
                                            <TextBlock Text="&#xE189;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <Border CornerRadius="8" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Button Command="{Binding ChangeCoverArtCommand}"
        Visibility="{Binding IsEditingTags, Converter={StaticResource BooleanToVisibilityConverter}}"
        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" Margin="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CoverBorder" Width="100" Height="100" CornerRadius="8" Background="Black" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform x:Name="CoverScale" ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>

                                                    <Border x:Name="ContentLayer" CornerRadius="8" Background="#141416">
                                                        <Grid>
                                                            <TextBlock x:Name="PlaceholderIcon" Text="&#xE189;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                                                            <Border x:Name="ImageLayer" CornerRadius="8" RenderOptions.BitmapScalingMode="HighQuality">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding EditAlbumArtPreview}" Stretch="UniformToFill"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding EditAlbumArtPreview}" Value="{x:Null}">
                                                        <Setter TargetName="PlaceholderIcon" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=IsMouseOver}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ContentLayer" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ContentLayer" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Grid IsHitTestVisible="False"
          Visibility="{Binding IsEditingTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=EditCoverGrid, Path=IsMouseOver}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=ClearCoverBtn, Path=IsMouseOver}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Edit" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=ClearCoverBtn, Path=IsMouseOver}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#FF5555" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Remove Cover" FontSize="12" FontWeight="SemiBold" Foreground="#FF5555" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button x:Name="ClearCoverBtn" 
        Command="{Binding ClearCoverArtCommand}"
        HorizontalAlignment="Right" VerticalAlignment="Top"
        Margin="5" Width="22" Height="22"
        BorderThickness="0" Cursor="Hand" ToolTip="Remove Cover">
                                        <Button.Style>
                                            <Style TargetType="Button">

                                                <Setter Property="Visibility" Value="{Binding IsEditingTags, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <TextBlock x:Name="CrossGlyph" 
                                       Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" 
                                       Foreground="#FF5555" FontSize="16" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                                                    <TextBlock.RenderTransform>
                                                                        <ScaleTransform x:Name="GlyphScale" ScaleX="1" ScaleY="1"/>
                                                                    </TextBlock.RenderTransform>
                                                                </TextBlock>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <EventTrigger RoutedEvent="MouseEnter">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleX" To="1.3" Duration="0:0:0.1">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleY" To="1.3" Duration="0:0:0.1">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseLeave">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding EditAlbumArtPreview}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#2D2D30" Margin="0,5,0,20"/>

                        <TextBlock Text="AUDIO PROPERTIES" Foreground="{Binding DataContext.LightColor, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>

                        <UniformGrid Columns="4" Margin="0,0,0,20">
                            <UniformGrid.Resources>
                                <Style x:Key="AudioPropertyBadgeStyle" TargetType="Border">
                                    <Setter Property="Background" Value="#252528"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="BorderThickness" Value="1"/>

                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#55FFFFFF" Offset="0.0" />
                                                        <GradientStop Color="#10FFFFFF" Offset="0.5" />
                                                        <GradientStop Color="#15FFFFFF" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>

                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
                                                        <GradientStop Color="#08FFFFFF" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </UniformGrid.Resources>

                            <Border Style="{StaticResource AudioPropertyBadgeStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="FORMAT" Foreground="#666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding AudioFormat}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AudioPropertyBadgeStyle}" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="SAMPLE RATE" Foreground="#666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding AudioSampleRate}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AudioPropertyBadgeStyle}" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="BIT DEPTH" Foreground="#666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding AudioBitDepth}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AudioPropertyBadgeStyle}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="BITRATE" Foreground="#666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding AudioBitrate}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DURATION" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding TrackDuration}" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="FILE SIZE" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding TrackFileSize}" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#2D2D30" Margin="0,5,0,20"/>

                        <TextBlock Text="FILE LOCATION" Foreground="{Binding DataContext.LightColor, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Button Command="{Binding OpenTrackLocationInExplorerCommand}" 
        ToolTip="Click to open in Windows Explorer">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PathBorder" BorderThickness="0" CornerRadius="8" Padding="12,10" Cursor="Hand" RenderTransformOrigin="0.5,0.5">

                                        <Border.Background>
                                            <SolidColorBrush Color="#141416"/>
                                        </Border.Background>

                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

