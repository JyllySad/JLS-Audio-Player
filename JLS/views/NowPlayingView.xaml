                                <DataTemplate x:Key="QueueTrackTemplate">
                                    <Grid Margin="0,2" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
          ContextMenu="{StaticResource StandardTrackContextMenu}">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick" 
                          Command="{Binding DataContext.PlayFromQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                          CommandParameter="{Binding}"/>
                                        </Grid.InputBindings>
                                        <Grid>
                                            <Border CornerRadius="6" Margin="20,8,0,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <Border Padding="20,8,8,8" Background="Transparent" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="6" Background="#252525">
                                                        <Grid>
                                                            <TextBlock Text="&#xE189;" FontFamily="Segoe MDL2 Assets" Foreground="#777" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                                            <Border CornerRadius="6">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding FullPath, Converter={StaticResource PathToThumbnailConverter}, IsAsync=True}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="15,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource ComfortaaFont}" Foreground="{Binding DataContext.AdaptiveTextColor, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <TextBlock.Text>
                                                                <PriorityBinding>
                                                                    <Binding Path="Title" />
                                                                    <Binding Path="Name" />
                                                                </PriorityBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Artist}" FontFamily="{StaticResource ComfortaaFont}" Foreground="{Binding DataContext.AdaptiveTextColor, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.7" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock x:Name="DurationTextBlock" Text="{Binding Duration}" FontFamily="{StaticResource ComfortaaFont}" FontWeight="SemiBold" Foreground="{Binding DataContext.AdaptiveTextColor, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.6" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                        <Button x:Name="MoreOptionsBtn" 
            Style="{StaticResource QueueMoreOptionsBtnStyle}"
            Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
            Foreground="{Binding DataContext.AdaptiveTextColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
            VerticalAlignment="Center" HorizontalAlignment="Right"
            Opacity="0" IsHitTestVisible="False"
            Margin="0,0,-8,0" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="MoreOptionsBtn" Property="IsHitTestVisible" Value="True"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="DurationTextBlock" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="MoreOptionsBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="DurationTextBlock" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="MoreOptionsBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </Grid.Resources>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="OpacityMask" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNowPlayingFluidBackgroundEnabled}" Value="True">
                                            <Setter Property="OpacityMask">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="Transparent" Offset="0"/>
                                                        <GradientStop Color="Black" Offset="0.10"/>
                                                        <GradientStop Color="Black" Offset="0.90"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <ListBox x:Name="UnifiedQueueListBox" 
         ItemsSource="{Binding UnifiedQueue}"
         Background="Transparent" BorderThickness="0"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         VirtualizingPanel.IsVirtualizing="True"
         VirtualizingPanel.VirtualizationMode="Standard"
         VirtualizingPanel.ScrollUnit="Pixel"
         Margin="0,0,-5,0" Padding="0,0,15,0"
         PreviewMouseWheel="UnifiedQueueListBox_PreviewMouseWheel"
         PreviewMouseDown="UnifiedQueueListBox_PreviewMouseDown">

                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=ResumeQueueAutoScrollBtn}" Value="Visible">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Resources>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">

                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding HeaderText}" Foreground="{Binding DataContext.AdaptiveTextColor, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.5" FontSize="16" FontWeight="Bold" Margin="10,20,0,10"/>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTrack}" Value="True">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <ContentControl Content="{Binding Track}" ContentTemplate="{StaticResource QueueTrackTemplate}"/>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>

                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2" RenderTransformOrigin="0.5,0.5"
                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      ContextMenu="{StaticResource PlayingTrackContextMenu}">
                                                                            <Grid.RenderTransform>
                                                                                <ScaleTransform ScaleX="1" ScaleY="1" x:Name="ItemScale"/>
                                                                            </Grid.RenderTransform>

                                                                            <Border Background="#1AFFFFFF" CornerRadius="6"/>

                                                                            <Border x:Name="ActiveHighlight" 
                    Background="{Binding DataContext.LightColor, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                    Opacity="0.25" CornerRadius="6" 
                    RenderTransformOrigin="0,0.5">
                                                                                <Border.RenderTransform>
                                                                                    <ScaleTransform ScaleX="0" ScaleY="1" x:Name="HighlightScale"/>
                                                                                </Border.RenderTransform>
                                                                            </Border>

                                                                            <Border Padding="8">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="52"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="6" Background="#252525">
                                                                                    <Grid>
                                                                                        <TextBlock Text="&#xE189;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding DataContext.LightColor, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>

                                                                                        <Border CornerRadius="6">
                                                                                            <Border.Background>
                                                                                                <ImageBrush ImageSource="{Binding Track.FullPath, Converter={StaticResource PathToThumbnailConverter}, IsAsync=True}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                                            </Border.Background>
                                                                                        </Border>

                                                                                        <Border CornerRadius="6" IsHitTestVisible="False" Background="#88000000"/>

                                                                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="18" IsHitTestVisible="False">

                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="4"/>
                                                                                                <ColumnDefinition Width="2"/>
                                                                                                <ColumnDefinition Width="4"/>
                                                                                                <ColumnDefinition Width="2"/>
                                                                                                <ColumnDefinition Width="4"/>
                                                                                            </Grid.ColumnDefinitions>

                                                                                            <Grid.Resources>
                                                                                                <Style TargetType="Border">
                                                                                                    <Setter Property="Background" Value="{Binding DataContext.LightColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                                                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                                                                    <Setter Property="CornerRadius" Value="2"/>
                                                                                                    <Setter Property="Height" Value="18"/>
                                                                                                    <Setter Property="RenderTransformOrigin" Value="0.5, 1"/>
                                                                                                    <Setter Property="RenderTransform">
                                                                                                        <Setter.Value>
                                                                                                            <ScaleTransform ScaleY="0.2"/>
                                                                                                        </Setter.Value>
                                                                                                    </Setter>
                                                                                                </Style>
                                                                                            </Grid.Resources>

                                                                                            <Border Grid.Column="0">
                                                                                                <Border.Style>
                                                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                                                <DataTrigger.EnterActions>
                                                                                                                    <BeginStoryboard Name="Anim1">
                                                                                                                        <Storyboard Timeline.DesiredFrameRate="24" RepeatBehavior="Forever" AutoReverse="True">
                                                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.3" To="1.0" Duration="0:0:0.35" />
                                                                                                                        </Storyboard>
                                                                                                                    </BeginStoryboard>
                                                                                                                </DataTrigger.EnterActions>
                                                                                                                <DataTrigger.ExitActions>
                                                                                                                    <StopStoryboard BeginStoryboardName="Anim1"/>
                                                                                                                    <BeginStoryboard>
                                                                                                                        <Storyboard Timeline.DesiredFrameRate="24">
                                                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.2" Duration="0:0:0.2">
                                                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                                                                </DoubleAnimation.EasingFunction>
                                                                                                                            </DoubleAnimation>
                                                                                                                        </Storyboard>
                                                                                                                    </BeginStoryboard>
                                                                                                                </DataTrigger.ExitActions>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                            </Border>

                                                                                            <Border Grid.Column="2">
                                                                                                <Border.Style>
                                                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                                                <DataTrigger.EnterActions>
                                                                                                                    <BeginStoryboard Name="Anim2">
                                                                                                                        <Storyboard Timeline.DesiredFrameRate="24" RepeatBehavior="Forever" AutoReverse="True">
                                                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="0.2" Duration="0:0:0.45" />
                                                                                                                        </Storyboard>
                                                                                                                    </BeginStoryboard>
                                                                                                                </DataTrigger.EnterActions>
                                                                                                                <DataTrigger.ExitActions>
                                                                                                                    <StopStoryboard BeginStoryboardName="Anim2"/>
                                                                                                                    <BeginStoryboard>
                                                                                                                        <Storyboard Timeline.DesiredFrameRate="24">
                                                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.2" Duration="0:0:0.2">
                                                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                                                                </DoubleAnimation.EasingFunction>
                                                                                                                            </DoubleAnimation>
                                                                                                                        </Storyboard>
                                                                                                                    </BeginStoryboard>
                                                                                                                </DataTrigger.ExitActions>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                            </Border>

                                                                                            <Border Grid.Column="4">
                                                                                                <Border.Style>
                                                                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                                                <DataTrigger.EnterActions>
                                                                                                                    <BeginStoryboard Name="Anim3">
                                                                                                                        <Storyboard Timeline.DesiredFrameRate="24" RepeatBehavior="Forever" AutoReverse="True">
                                                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.4" To="0.9" Duration="0:0:0.25" />
                                                                                                                        </Storyboard>
                                                                                                                    </BeginStoryboard>
                                                                                                                </DataTrigger.EnterActions>
                                                                                                                <DataTrigger.ExitActions>
                                                                                                                    <StopStoryboard BeginStoryboardName="Anim3"/>
                                                                                                                    <BeginStoryboard>
                                                                                                                        <Storyboard Timeline.DesiredFrameRate="24">
                                                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.2" Duration="0:0:0.2">
                                                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                                                                </DoubleAnimation.EasingFunction>
                                                                                                                            </DoubleAnimation>
                                                                                                                        </Storyboard>
                                                                                                                    </BeginStoryboard>
                                                                                                                </DataTrigger.ExitActions>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                            </Border>
                                                                                        </Grid>
