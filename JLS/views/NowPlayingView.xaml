                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                    <Border Height="80" VerticalAlignment="Top" IsHitTestVisible="False" 
            Background="{Binding BottomPanelBackground}" Panel.ZIndex="5" Margin="0,0,-5,0">
