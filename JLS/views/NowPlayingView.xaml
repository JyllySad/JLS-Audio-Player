                                                <GradientStop Color="Black" Offset="0.0"/>
                                                <GradientStop Color="Transparent" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>

                                    <Border Height="80" VerticalAlignment="Bottom" IsHitTestVisible="False" 
            Background="{Binding BottomPanelBackground}" Panel.ZIndex="5" Margin="0,0,-5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNowPlayingFluidBackgroundEnabled}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
