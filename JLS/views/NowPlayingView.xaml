                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" Foreground="White" VerticalAlignment="Center"/>
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <MenuItem Header="Track Information" 
                  Command="{Binding PlacementTarget.Tag.ShowTrackInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext.Track.FullPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
