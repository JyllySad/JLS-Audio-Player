           FontSize="12" FontWeight="SemiBold" 
           VerticalAlignment="Center" HorizontalAlignment="Center" 
           Margin="4,2"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Background="Transparent" MouseMove="ClassicArea_MouseMove" MouseLeave="ClassicArea_MouseLeave">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NowPlayingControlStyle}" Value="Classic">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NowPlayingControlStyle}" Value="Animated">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <controls:AnimatedProgressBar 
            Height="30" 
            VerticalAlignment="Center"
            LeftPeaks="{Binding LeftWaveform}" 
            RightPeaks="{Binding RightWaveform}" 
            Progress="{Binding WaveformProgress}" 
            IsPlaying="{Binding IsPlaying}"
                                    FftData="{Binding FftData}"
            PlayedBrush="{Binding LightColor}" 
            UnplayedBrush="{Binding DarkColor}">
                                    <controls:AnimatedProgressBar.Style>
                                        <Style TargetType="controls:AnimatedProgressBar">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NowPlayingControlStyle}" Value="Animated">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:AnimatedProgressBar.Style>
                                </controls:AnimatedProgressBar>

                                <Slider x:Name="ClassicView" 
                UseLayoutRounding="False" 
                SnapsToDevicePixels="False" 
                Minimum="0" 
                Maximum="{Binding TotalDuration}" 
                Value="{Binding CurrentPosition, Mode=TwoWay}" 
                VerticalAlignment="Center" 
                Height="30" 
                Cursor="Hand"
                PreviewMouseLeftButtonDown="TrackSlider_PreviewMouseLeftButtonDown"
                PreviewMouseMove="TrackSlider_PreviewMouseMove"
                PreviewMouseLeftButtonUp="TrackSlider_PreviewMouseLeftButtonUp">
                                    <Slider.Style>
                                        <Style TargetType="Slider" BasedOn="{StaticResource NowPlayingSliderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NowPlayingControlStyle}" Value="Animated">
                                                    <Setter Property="Opacity" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Slider.Style>
                                </Slider>

                                <Border x:Name="ClassicHoverBubble" MinWidth="45" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Margin="-22.5,-40,0,0" Opacity="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" x:Name="ClassicHoverTransform"/>
                                    </Border.RenderTransform>

                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="8" ShadowDepth="2" Direction="270"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Border Background="{Binding BottomPanelBackground}" Opacity="0.85" CornerRadius="6"/>
                                        <Border BorderBrush="{Binding AdaptiveTextColor}" BorderThickness="0" Opacity="0.15" CornerRadius="6"/>
                                        <TextBlock x:Name="ClassicHoverText" Text="00:00" 
           Foreground="{Binding AdaptiveTextColor}" 
           FontFamily="Century Gothic"
           Typography.NumeralAlignment="Tabular"
           FontSize="12" FontWeight="SemiBold" 
           VerticalAlignment="Center" HorizontalAlignment="Center" 
           Margin="4,2"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <TextBlock x:Name="TotalTimeText" Grid.Column="2" 
           Text="{Binding TotalTimeSimple}" 
           Foreground="{Binding AdaptiveTextColor}" 
           FontSize="23" FontWeight="Regular" 
           FontFamily="Century Gothic" 
           Typography.NumeralAlignment="Tabular"
           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">

                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black" Opacity="0.4"/>
                            </TextBlock.Effect>

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAlwaysShowTrackTimingsEnabled}" Value="False"/>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1" Width="0" ClipToBounds="True" MaxWidth="{Binding ActualWidth, ElementName=AvailableSpace}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Tag" Value="Closed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLyricsOpen}" Value="True">
                                    <Setter Property="Tag" Value="Open" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsQueueOpen}" Value="True">
                                    <Setter Property="Tag" Value="Open" />
                                </DataTrigger>

                                <Trigger Property="Tag" Value="Open">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="840" Duration="0:0:0.5">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="40,0,0,0" Duration="0:0:0.5">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,0,0,0" Duration="0:0:0.4">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid x:Name="LyricsPanelContainer" Opacity="0" IsHitTestVisible="False">
                        <Grid.RenderTransform>
                            <TranslateTransform X="300" Y="0"/>
                        </Grid.RenderTransform>

                        <Grid MaxWidth="840" Width="{Binding ActualWidth, ElementName=AvailableSpace}" HorizontalAlignment="Left">

                            <Grid.CacheMode>
                            <BitmapCache EnableClearType="True" SnapsToDevicePixels="True"/>
                        </Grid.CacheMode>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                            Visibility="{Binding HasLyrics, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="No lyrics found" Foreground="{Binding AdaptiveTextColor}" Opacity="0.6" FontSize="22" FontFamily="{StaticResource ComfortaaFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <Button Command="{Binding OpenLyricsEditorCommand}" Margin="0,20,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                                            </Grid.RenderTransform>

                                            <Border CornerRadius="24" Background="Black" Opacity="0.15">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="3" Color="Black"/>
                                                </Border.Effect>
                                            </Border>

                                            <Border x:Name="BtnBackground" Background="{Binding AdaptiveTextColor}" Opacity="0.1" CornerRadius="24"/>

                                            <Border x:Name="BtnBorder" BorderBrush="{Binding AdaptiveTextColor}" BorderThickness="1" Opacity="0.15" CornerRadius="24"/>

                                                <StackPanel Orientation="Horizontal" Margin="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Add lyrics" Foreground="{Binding AdaptiveTextColor}" 
               FontSize="15" FontFamily="{StaticResource ComfortaaFont}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,-3"/>
                                                </StackPanel>
                                            </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBackground" Property="Opacity" Value="0.2"/>
                                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.3"/>
                                            </Trigger>

                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>

                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>

                                            <EventTrigger RoutedEvent="PreviewMouseDown">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.05"/>
                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.05"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>

                                            <EventTrigger RoutedEvent="PreviewMouseUp">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                <Grid Visibility="{Binding HasLyrics, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-5,0" Padding="0,0,15,0">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLyricsStyle}" Value="Compact">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>

                                <Grid>
                                    <TextBlock Text="{Binding CurrentLyrics}" TextWrapping="Wrap" 
                   Foreground="{Binding AdaptiveTextColor}" FontFamily="{StaticResource ComfortaaFont}" FontSize="17" LineHeight="24" Opacity="0.8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSyncedLyricsMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,150,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSyncedLyricsMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="48" 
                       Foreground="{Binding AdaptiveTextColor}" Opacity="0.4" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                        <TextBlock Text="Synced lyrics are not supported in Compact mode" 
                       Foreground="{Binding AdaptiveTextColor}" FontSize="20" FontFamily="{StaticResource ComfortaaFont}" FontWeight="Bold" Opacity="0.8" 
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                                        <TextBlock Text="Please switch to Beautiful mode in the interface settings." 
                       Foreground="{Binding AdaptiveTextColor}" FontSize="15" FontFamily="{StaticResource ComfortaaFont}" Opacity="0.5" 
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,150,0,0"
                                                Visibility="{Binding ShowEnableSyncMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="48" 
                                                   Foreground="{Binding AdaptiveTextColor}" Opacity="0.4" 
                                                   HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                        <TextBlock Text="Plain lyrics not found" 
                                                   Foreground="{Binding AdaptiveTextColor}" FontSize="20" FontFamily="{StaticResource ComfortaaFont}" FontWeight="Bold" Opacity="0.8" 
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Text="This track only has synced lyrics." 
                                                   Foreground="{Binding AdaptiveTextColor}" FontSize="15" FontFamily="{StaticResource ComfortaaFont}" Opacity="0.5" 
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <TextBlock Text="Please switch to Beautiful mode to view them." 
                                                   Foreground="{Binding AdaptiveTextColor}" FontSize="15" FontFamily="{StaticResource ComfortaaFont}" Opacity="0.5" 
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="OpacityMask" Value="{x:Null}"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLyricsStyle}" Value="Beautiful">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsNowPlayingFluidBackgroundEnabled}" Value="True">
                                                    <Setter Property="OpacityMask">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="Transparent" Offset="0"/>
                                                                <GradientStop Color="Black" Offset="0.15"/>
                                                                <GradientStop Color="Black" Offset="0.85"/>
                                                                <GradientStop Color="Transparent" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-5,0" Padding="0,0,15,0"
                  Visibility="{Binding IsSyncedLyricsMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding CurrentLyrics}" FontFamily="{StaticResource ComfortaaFont}" TextWrapping="NoWrap" 
           Foreground="{Binding AdaptiveTextColor}" FontSize="23" FontWeight="Bold" 
           LineHeight="60" TextAlignment="Center" Margin="0,80"/>
                                </ScrollViewer>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding ShowEnableSyncMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="56" 
                                               Foreground="{Binding AdaptiveTextColor}" Opacity="0.4" 
                                               HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBlock Text="Plain lyrics not found" 
                                               Foreground="{Binding AdaptiveTextColor}" FontSize="24" FontFamily="{StaticResource ComfortaaFont}" FontWeight="Bold" Opacity="0.8" 
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="Please enable Sync Timestamps Mode." 
                                               Foreground="{Binding AdaptiveTextColor}" FontSize="16" FontFamily="{StaticResource ComfortaaFont}" Opacity="0.5" 
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="5"
                                            Visibility="{Binding ShowAddSyncedLyricsMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="56" 
                                               Foreground="{Binding AdaptiveTextColor}" Opacity="0.4" 
                                               HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBlock Text="Synced lyrics not found" 
                                               Foreground="{Binding AdaptiveTextColor}" FontSize="24" FontFamily="{StaticResource ComfortaaFont}" FontWeight="Bold" Opacity="0.8" 
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="This track only has plain text lyrics." 
                                               Foreground="{Binding AdaptiveTextColor}" FontSize="16" FontFamily="{StaticResource ComfortaaFont}" Opacity="0.5" 
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                    <Button Command="{Binding OpenLyricsEditorCommand}" Margin="0,20,0,0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>

                                                    <Border CornerRadius="24" Background="Black" Opacity="0.15">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="3" Color="Black"/>
                                                        </Border.Effect>
                                                    </Border>

                                                    <Border x:Name="BtnBackground" Background="{Binding AdaptiveTextColor}" Opacity="0.1" CornerRadius="24"/>
                                                    <Border x:Name="BtnBorder" BorderBrush="{Binding AdaptiveTextColor}" BorderThickness="1" Opacity="0.15" CornerRadius="24"/>

                                                        <StackPanel Orientation="Horizontal" Margin="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="Add synced lyrics" Foreground="{Binding AdaptiveTextColor}" 
               FontSize="15" FontFamily="{StaticResource ComfortaaFont}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,-3"/>
                                                        </StackPanel>
                                                    </Grid>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBackground" Property="Opacity" Value="0.2"/>
                                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.3"/>
                                                    </Trigger>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="PreviewMouseDown">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.05"/>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.05"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="PreviewMouseUp">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <ListBox x:Name="SyncedLyricsListBox" ItemsSource="{Binding SyncedLyrics}"
         Background="Transparent" BorderThickness="0"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.CanContentScroll="False"
         VirtualizingPanel.IsVirtualizing="False"
         Margin="0,0,-5,0" Padding="10,0,120,0" 
         HorizontalContentAlignment="Stretch" UseLayoutRounding="False" SnapsToDevicePixels="False"
         Visibility="{Binding IsSyncedLyricsMode, Converter={StaticResource BooleanToVisibilityConverter}}"
         PreviewMouseWheel="SyncedLyricsListBox_PreviewMouseWheel"
         PreviewMouseDown="SyncedLyricsListBox_PreviewMouseDown">

                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=ResumeAutoScrollBtn}" Value="Visible">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Resources>

                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Margin="0,350,0,350" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,15">

                                                <TextBlock Text="{Binding Text}" 
           Foreground="{Binding DataContext.AdaptiveTextColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
           TextWrapping="Wrap" Cursor="Hand"
           RenderTransformOrigin="0.5,0.5"
           TextAlignment="Center" HorizontalAlignment="Stretch">

                                                    <TextBlock.RenderTransform>
                                                        <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                                                    </TextBlock.RenderTransform>

                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="FontFamily" Value="{StaticResource ComfortaaFont}"/>
                                                            <Setter Property="FontSize" Value="40"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>

                                                            <Setter Property="Opacity" Value="0.66"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <BlurEffect Radius="0" KernelType="Gaussian" RenderingBias="Performance"/>
                                                                </Setter.Value>
                                                            </Setter>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.SelectedBeautifulLyricsFont, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Bold">
                                                                    <Setter Property="FontFamily" Value="{StaticResource NunitoFont}"/>
                                                                    <Setter Property="FontSize" Value="44"/>
                                                                    <Setter Property="FontWeight" Value="Black"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Text}" Value="COUNTDOWN_ANIMATION">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>

                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsPassed}" Value="False"/>
                                                                        <Condition Binding="{Binding IsActive}" Value="False"/>
                                                                            <Condition Binding="{Binding IsNext}" Value="False"/>
                                                                            <Condition Binding="{Binding Visibility, ElementName=ResumeAutoScrollBtn}" Value="Collapsed"/>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="7" Duration="0:0:0.25">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.20">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>

                                                                <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.18"/>
                                                                </DataTrigger>

                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsPassed}" Value="False"/>
                                                                        <Condition Binding="{Binding IsActive}" Value="False"/>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.20"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.25"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>

                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsPassed}" Value="True"/>
                                                                        <Condition Binding="{Binding IsActive}" Value="False"/>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.40" Duration="0:0:0.20"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.25"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>

                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.45">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.45">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.35">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.7" Duration="0:0:0.5">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.7" Duration="0:0:0.5">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.4">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding Gesture="LeftClick" 
                              Command="{Binding DataContext.SeekToLyricCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                              CommandParameter="{Binding Timestamp}"/>
                                                    </TextBlock.InputBindings>
                                                </TextBlock>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="40"
            SnapsToDevicePixels="False" 
            UseLayoutRounding="False"
            RenderOptions.EdgeMode="Unspecified">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Opacity" Value="0.0"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text}" Value="COUNTDOWN_ANIMATION">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>

                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Text}" Value="COUNTDOWN_ANIMATION"/>
                                                                        <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>

                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.3">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>

                                                                    <MultiDataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.4">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <QuadraticEase EasingMode="EaseInOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <Ellipse Width="20" Height="20" Margin="0,0,20,0" RenderTransformOrigin="0.5,0.5"
             Fill="{Binding DataContext.AdaptiveTextColor, RelativeSource={RelativeSource AncestorType=UserControl}}" 
             Opacity="{Binding DataContext.CountdownDot1Opacity, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Ellipse.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding DataContext.CountdownDot1Scale, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            ScaleY="{Binding DataContext.CountdownDot1Scale, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>

                                                    <Ellipse Width="20" Height="20" Margin="0,0,20,0" RenderTransformOrigin="0.5,0.5"
             Fill="{Binding DataContext.AdaptiveTextColor, RelativeSource={RelativeSource AncestorType=UserControl}}" 
             Opacity="{Binding DataContext.CountdownDot3Opacity, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Ellipse.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding DataContext.CountdownDot3Scale, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            ScaleY="{Binding DataContext.CountdownDot3Scale, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>

                                                    <Ellipse Width="20" Height="20" RenderTransformOrigin="0.5,0.5"
             Fill="{Binding DataContext.AdaptiveTextColor, RelativeSource={RelativeSource AncestorType=UserControl}}" 
             Opacity="{Binding DataContext.CountdownDot2Opacity, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Ellipse.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding DataContext.CountdownDot2Scale, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            ScaleY="{Binding DataContext.CountdownDot2Scale, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </StackPanel>

                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
