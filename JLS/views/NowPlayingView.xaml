                                                                                    <Setter Property="Opacity" Value="1.0"/>
                                                                                </Trigger>

                                                                                <EventTrigger RoutedEvent="MouseEnter">
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="1.35" Duration="0:0:0.15">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                            <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="1.35" Duration="0:0:0.15">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </EventTrigger>

                                                                                <EventTrigger RoutedEvent="MouseLeave">
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                            <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </EventTrigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Border Grid.Column="3" CornerRadius="4" BorderThickness="2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1A1A1A"/>
                                                                <Setter Property="BorderBrush" Value="#333"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Background" Value="#252525"/>
                                                                        <Setter Property="BorderBrush" Value="{Binding DataContext.LightColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Background">
                                                                            <Setter.Value>
                                                                                <SolidColorBrush Color="#1A1A1A" Opacity="0.3"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Setter Property="BorderBrush">
                                                                            <Setter.Value>
                                                                                <SolidColorBrush Color="#333333" Opacity="0.5"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>

                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                            <Condition Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Background">
                                                                            <Setter.Value>
                                                                                <SolidColorBrush Color="#252525" Opacity="0.65"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" Foreground="White" 
                                                             BorderThickness="0" Padding="8,5" FontSize="15"
                                                             CaretBrush="White" AcceptsReturn="True" TextWrapping="Wrap"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Search on Web" Padding="15,10" 
                                        Command="{Binding SearchLyricsOnWebCommand}"
                                        Background="#2D2D30" Style="{StaticResource PopupActionBtnStyle}"/>

                                <Button Grid.Column="1" Content="Import .lrc" Padding="15,10" Margin="10,0,0,0"
                                        Command="{Binding ImportLrcFileCommand}"
                                        Background="#2D2D30" Style="{StaticResource AnimatedSyncedBtnStyle}"/>

                                <Button Grid.Column="2" Content="Export .lrc" Padding="15,10" Margin="10,0,0,0"
                                        Command="{Binding ExportLrcFileCommand}"
                                        Background="#2D2D30" Style="{StaticResource AnimatedExportBtnStyle}"/>

                                <Button Grid.Column="4" Content="Cancel" Padding="15,10" Margin="0,0,10,0"
                                        Command="{Binding CloseLyricsEditorCommand}"
                                        Background="Transparent" Foreground="#A0A0A0" Style="{StaticResource PopupActionBtnStyle}"/>

                                <Button Grid.Column="5" Content="Save" Padding="25,10" 
                                        Command="{Binding SaveLyricsCommand}"
                                        Background="{Binding LightColor}" Foreground="Black" FontWeight="Bold" Style="{StaticResource PopupActionBtnStyle}"/>
                            </Grid>
                        </Grid>

                        <Border CornerRadius="12" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>

                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#44FFFFFF" Offset="0.0" />
                                                        <GradientStop Color="#0AFFFFFF" Offset="0.15" />
                                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>

                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#15FFFFFF" Offset="0.0" />
                                                        <GradientStop Color="#08FFFFFF" Offset="0.15" />
                                                        <GradientStop Color="#04FFFFFF" Offset="0.5" />
                                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

           
            

        </Grid>
    </Border>
</UserControl>