<Window x:Class="JLS.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:JLS.Properties"
        Title="Loading..." 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Width="430" Height="350" Topmost="True"
        Opacity="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="Transparent" Margin="20">

        <Grid Background="Transparent" Margin="20">

            <Border CornerRadius="24">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#121212"/>
                        <Setter Property="BorderBrush" Value="#2D2D30"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source={x:Static properties:Settings.Default}, Path=IsGlassModeEnabled}" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#121212" Opacity="0.85"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="GreetingLabel" 
                       Text="Hello" 
                       FontSize="32" 
                       FontWeight="SemiBold" 
                       Foreground="White" 
                       Opacity="0"
                       Margin="0,0,0,30" 
                       HorizontalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TextSlide" Y="20"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <Image x:Name="LogoImage" 
           Source="/logoui.png" 
           Width="180" Height="180"
           Margin="0,-20,0,-20"
           RenderTransformOrigin="0.5,0.5"
           HorizontalAlignment="Center"
           RenderOptions.BitmapScalingMode="HighQuality"
           Opacity="0">
                        <Image.Effect>
                            <DropShadowEffect x:Name="LogoShadow" BlurRadius="30" ShadowDepth="0" Opacity="0" Color="Black"/>
                        </Image.Effect>
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1.15" ScaleY="1.15" x:Name="LogoScale"/>
                        </Image.RenderTransform>
                    </Image>
                </StackPanel>
            </Border>

            <Border CornerRadius="24" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source={x:Static properties:Settings.Default}, Path=IsGlassModeEnabled}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="BorderThickness" Value="1.5"/>

                                <Setter Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#88FFFFFF" Offset="0.0" />
                                            <GradientStop Color="#1AFFFFFF" Offset="0.15" />
                                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>

                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#26FFFFFF" Offset="0.0" />
                                            <GradientStop Color="#0EFFFFFF" Offset="0.15" />
                                            <GradientStop Color="#0AFFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Border CornerRadius="24" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <SkewTransform AngleX="-25"/>
                                <TranslateTransform x:Name="ShineTranslate" X="-1.5"/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>

                        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#2AFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

        </Grid>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>

                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1" Duration="0:0:0.7">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="GreetingLabel" Storyboard.TargetProperty="Opacity"
                     From="0" To="0.95" BeginTime="0:0:0.2" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <QuinticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="TextSlide" Storyboard.TargetProperty="Y"
                     From="20" To="0" BeginTime="0:0:0.2" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <QuinticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="LogoImage" Storyboard.TargetProperty="Opacity"
                     From="0" To="1.0" BeginTime="0:0:0.2" Duration="0:0:1.5">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX"
                     From="1.15" To="1.0" BeginTime="0:0:0.2" Duration="0:0:2.5">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY"
                     From="1.15" To="1.0" BeginTime="0:0:0.2" Duration="0:0:2.5">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="LogoShadow" Storyboard.TargetProperty="Opacity"
                     From="0" To="0.75" BeginTime="0:0:0.5" Duration="0:0:2.0">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShineTranslate" Storyboard.TargetProperty="X" RepeatBehavior="Forever">
                        <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="-1.5"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="1.5"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:5.0" Value="1.5"/>
                        <DiscreteDoubleKeyFrame KeyTime="0:0:5.0" Value="-1.5"/>
                    </DoubleAnimationUsingKeyFrames>

                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>