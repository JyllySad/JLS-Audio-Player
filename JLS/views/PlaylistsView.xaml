        <ContextMenu x:Key="PlaylistItemContextMenu">
            <MenuItem Header="Create New Playlist" 
              Command="{Binding PlacementTarget.Tag.CreatePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Delete Playlist" Foreground="#FF5555"
              Command="{Binding PlacementTarget.Tag.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5555"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="TrackContextMenu">
            <MenuItem Header="Add to Playlist" ItemsSource="{Binding PlacementTarget.Tag.Manager.Playlists, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource PlaylistIconGeometry}" Fill="White" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                </MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}"/>
                        <Setter Property="IsCheckable" Value="True"/>
                        <Setter Property="IsChecked">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource PlaylistTrackMultiConverter}" Mode="OneWay">
                                    <Binding Path="."/>
                                    <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Command" Value="{Binding PlacementTarget.Tag.TogglePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Setter Property="CommandParameter">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource PlaylistTrackMultiConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Add Track" Command="{Binding PlacementTarget.Tag.AddTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Rename" 
              Command="{Binding PlacementTarget.Tag.RenameTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show in Explorer" 
              Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
              CommandParameter="{Binding PlacementTarget.DataContext.FullPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource ExplorerIconGeometry}" Fill="White" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Track Information" CommandParameter="{Binding PlacementTarget.DataContext.FullPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <EventSetter Event="MenuItem.Click" Handler="TrackInfoMenuItem_Click"/>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Delete from Playlist" Foreground="#FF5555" 
              Command="{Binding PlacementTarget.Tag.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF5555"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="BulkContextMenu">
            <MenuItem Header="Add all to Playlist" ItemsSource="{Binding Manager.Playlists}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}"/>
                        <EventSetter Event="Click" Handler="BulkAddToPlaylistMenuItem_Click"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
                <MenuItem.Icon>
                    <Path Data="{StaticResource PlaylistIconGeometry}" Fill="White" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Edit Tags for All Files" Click="BulkEditTagsMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="White" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Delete from Playlist" Foreground="#FF5555" Click="BulkRemoveTracksMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#FF5555" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="ColumnHeaderContextMenu">
            <MenuItem Header="Show/Hide Columns" IsEnabled="False" FontWeight="Bold"/>
            <Separator/>
        </ContextMenu>

        <Style x:Key="MinimalColorSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TickBar x:Name="TopTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Top" Height="4" Grid.Row="0"/>
                            <TickBar x:Name="BottomTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Bottom" Height="4" Grid.Row="2"/>
                            <Border x:Name="TrackBackground" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="1" Height="4" VerticalAlignment="Center" Grid.Row="1" Margin="5,0"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="14" Height="14" Focusable="False" OverridesDefaultStyle="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="#333" StrokeThickness="0.5">
                                                    
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    

    <Grid Background="#1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="250" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="SidebarContainer" Grid.Column="0" Background="#181818">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="16" Height="32" x:Name="LeftHeaderGrid" Panel.ZIndex="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1E1E1E"/>
                        <Setter Property="Margin" Value="10,10,10,1"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#BB2A2A2A" Offset="0.0"/>
                                            <GradientStop Color="#99151515" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Margin" Value="12,10,19,0"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid x:Name="SearchPlaylistRootGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Background="Black" CornerRadius="16"
                            Width="{Binding ActualWidth, ElementName=SearchPlaylistRootGrid}" 
                            Height="{Binding ActualHeight, ElementName=SearchPlaylistRootGrid}"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Grid.OpacityMask>

                    

                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="GotKeyboardFocus">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PlaylistSearchHighlight" 
                                         Storyboard.TargetProperty="Opacity" 
                                         To="0.08" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="LostKeyboardFocus">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PlaylistSearchHighlight" 
                                         Storyboard.TargetProperty="Opacity" 
                                         To="0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>

                    <Border Grid.ColumnSpan="3" IsHitTestVisible="False" CornerRadius="15" BorderThickness="1,1,1,0" Panel.ZIndex="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="BorderBrush">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#44FFFFFF" Offset="0.0" />
                                                    <GradientStop Color="#05FFFFFF" Offset="0.4" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Border x:Name="PlaylistSearchHighlight" Grid.ColumnSpan="3" Background="White" Opacity="0" CornerRadius="16" IsHitTestVisible="False"/>

                    <Button Grid.Column="0" Command="{Binding CreatePlaylistCommand}" 
                Background="Transparent" BorderThickness="0" Cursor="Hand" 
                Width="28" Height="28" Margin="1,0,0,0" ToolTip="Create New Playlist">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    <Ellipse x:Name="HoverOverlay" Fill="#20FFFFFF" Opacity="0"/>

                                    <TextBlock x:Name="PlusIcon" Text="&#xE109;" FontFamily="Segoe MDL2 Assets" 
                                   Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="PlusIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="PlusIcon" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="PreviewMouseDown">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.85" Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.85" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="PreviewMouseUp">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" 
                   Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0"/>

                    <TextBox x:Name="SearchPlaylistBox" Grid.Column="2" 
                 Text="{Binding SearchPlaylistText, UpdateSourceTrigger=PropertyChanged}" 
                 Background="Transparent" Foreground="White" BorderThickness="0" 
                 Padding="8,6,30,6" VerticalContentAlignment="Center" FontWeight="SemiBold"/>

                    <Button x:Name="ClosePlaylistSearchBtn" Grid.Column="2" Content="&#xE894;" FontFamily="Segoe MDL2 Assets" 
                Background="Transparent" BorderThickness="0" Cursor="Hand" Width="24" Height="24"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                Click="ClosePlaylistSearchBtn_Click" ToolTip="Clear Search">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=SearchPlaylistBox}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="4">
                                    <TextBlock x:Name="Icon" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" 
                                   RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#888888"/>
                                        </TextBlock.Foreground>
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="White" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#888888" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ListView x:Name="PlaylistsListView" ItemsSource="{Binding Manager.Playlists}" 
          SelectedItem="{Binding SelectedPlaylist}" 
          SelectionChanged="PlaylistsListView_SelectionChanged"
          Background="Transparent" BorderThickness="0" 
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          VirtualizingStackPanel.ScrollUnit="Pixel"
          PreviewMouseLeftButtonDown="PlaylistsList_PreviewMouseLeftButtonDown"
          PreviewMouseMove="PlaylistsList_MouseMove"
          PreviewMouseLeftButtonUp="PlaylistsList_MouseUp"
          MouseLeave="PlaylistsList_MouseLeave">

                <ListView.Style>
                    <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                        <Setter Property="Grid.Row" Value="1"/>
                        <Setter Property="Grid.RowSpan" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.RowSpan" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>

                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel>
                            <VirtualizingStackPanel.Style>
                                <Style TargetType="VirtualizingStackPanel">
                                    <Setter Property="Margin" Value="0"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsMinimalBottomPanelEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Margin" Value="0,52,0,200"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsMinimalBottomPanelEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Margin" Value="0,52,0,110"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </VirtualizingStackPanel.Style>
                        </VirtualizingStackPanel>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>


                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Create Playlist" Command="{Binding CreatePlaylistCommand}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" Padding="4,4"
        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
        ContextMenu="{StaticResource PlaylistItemContextMenu}">

                            <Grid Height="72">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="CoverContainer" Grid.Column="0" Height="64" ClipToBounds="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="MaxWidth" Value="0"/>
                                            <Setter Property="Opacity" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,0"/>

                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasCover}" Value="True"/>
                                                        <Condition Binding="{Binding ShowCover}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>

                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="MaxWidth" To="64" Duration="0:0:0.3">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="4,0,0,0" Duration="0:0:0.3">
                                                                    <ThicknessAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </ThicknessAnimation.EasingFunction>
                                                                </ThicknessAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>

                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="MaxWidth" To="0" Duration="0:0:0.3">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0,0,0,0" Duration="0:0:0.3">
                                                                    <ThicknessAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </ThicknessAnimation.EasingFunction>
                                                                </ThicknessAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid Width="64" HorizontalAlignment="Left">

                                        <Grid.Clip>
                                            <RectangleGeometry Rect="0,0,64,64" RadiusX="8" RadiusY="8"/>
                                        </Grid.Clip>

                                        <Border x:Name="CoverBorder" CornerRadius="8" Width="64" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource ImagePathToBitmapConverter}}" 
                    Stretch="UniformToFill" 
                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border.Background>
                                        </Border>

                                        <Button Command="{Binding DataContext.AskRemoveCoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
            CommandParameter="{Binding}" 
            Background="#99000000" 
            BorderThickness="0" Cursor="Hand" Opacity="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" 
                               Foreground="#FF4444" FontSize="22" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CoverContainer}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Name}" 
                                               Foreground="{Binding ColorHex, Converter={StaticResource ColorToContrastBrushConverter}}" 
                                               FontSize="20" FontWeight="ExtraBold" 
                                               Margin="0,0,0,4" Padding="0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="{Binding ColorHex, Converter={StaticResource ColorToContrastBrushConverter}}" 
                                               Opacity="0.65" FontSize="14" FontWeight="SemiBold"
                                               Padding="0" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource PlaylistStatsConverter}">
                                                <Binding Path="Items"/>
                                                <Binding Path="Items.Count"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <ToggleButton x:Name="MenuButton" Grid.Column="2" 
              Background="Transparent" BorderThickness="0" 
              Cursor="Hand" Width="30" 
              VerticalAlignment="Top" Margin="0,8,4,0" 
              FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <TextBlock x:Name="DotsIcon" Text="&#xE712;" FontFamily="Segoe MDL2 Assets" 
                           Foreground="{Binding ColorHex, Converter={StaticResource ColorToContrastBrushConverter}}" 
                           Opacity="0.6" FontSize="18" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="DotsIcon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.3" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="DotsIcon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.3" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="DotsIcon" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="DotsIcon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetName="DotsIcon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetName="DotsIcon" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup IsOpen="{Binding IsChecked, ElementName=MenuButton, Mode=TwoWay}" 
       StaysOpen="False" PlacementTarget="{Binding ElementName=MenuButton}" 
       Placement="Bottom" HorizontalOffset="-180" AllowsTransparency="True" PopupAnimation="Fade">

                                    <Border CornerRadius="6" Padding="15" Width="220" MouseLeftButtonDown="PopupBorder_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#252525"/>
                                                <Setter Property="BorderBrush" Value="#3F3F41"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=MainWindow.DataContext.IsGlassModeEnabled, Source={x:Static Application.Current}}" Value="True">
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#55FFFFFF" Offset="0.0" />
                                                                    <GradientStop Color="#08FFFFFF" Offset="0.4" />
                                                                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#F2181818" Offset="0.0"/>
                                                                    <GradientStop Color="#DD181818" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="SETTINGS" Foreground="#888" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>

                                            <TextBlock Text="Name:" Foreground="#ccc" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmoothTextBoxStyle}" Margin="0,0,0,12"/>

                                            <TextBlock Text="Playlist cover:" Foreground="#ccc" FontSize="12" Margin="0,0,0,4"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" 
            Command="{Binding DataContext.SelectCoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
            CommandParameter="{Binding}"
            Padding="6">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SmoothActionButtonStyle}">
                                                            <Setter Property="Content" Value="Browse Image"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCover}" Value="True">
                                                                    <Setter Property="Content" Value="Browse new image"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Grid.Column="1"
            Command="{Binding DataContext.AskRemoveCoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}"
            Margin="6,0,0,0" Width="32" Padding="0"
            ToolTip="Remove cover"
            RenderTransformOrigin="0.5,0.5">

                                                    <Button.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Button.RenderTransform>

                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SmoothActionButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCover}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>

                                                    <Button.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.12" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.12" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Button.Triggers>

                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" 
                   Foreground="#FF5555" FontSize="14" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>

                                            <CheckBox Content="Show cover image" 
          IsChecked="{Binding ShowCover}" 
          IsEnabled="{Binding HasCover}"
          Command="{Binding DataContext.SaveChangesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Style="{StaticResource PlaylistColorSwitchStyle}"/>

                                            <CheckBox Content="Use color from cover" 
          IsChecked="{Binding UseCoverColor}" 
          IsEnabled="{Binding HasCover}"
          Command="{Binding DataContext.ApplyCoverColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
          CommandParameter="{Binding}"
          Style="{StaticResource PlaylistColorSwitchStyle}"/>

                                            <Separator Background="#3F3F41" Margin="0,0,0,15"/>

                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UseCoverColor}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Opacity" Value="0.3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="Color:" Foreground="#ccc" FontSize="12" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="2"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="1" Height="24" Margin="5,0">
                                                        <Border CornerRadius="2" Height="4" VerticalAlignment="Center">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#FF0000" Offset="0.0" />
                                                                    <GradientStop Color="#FFFF00" Offset="0.16" />
                                                                    <GradientStop Color="#00FF00" Offset="0.33" />
                                                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                                                    <GradientStop Color="#0000FF" Offset="0.66" />
                                                                    <GradientStop Color="#FF00FF" Offset="0.83" />
                                                                    <GradientStop Color="#FF0000" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <Slider Value="{Binding Hue, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="360" VerticalAlignment="Center" Margin="-9,0" Style="{StaticResource MinimalColorSlider}"/>
                                                    </Grid>
                                                </Grid>

                                                <TextBlock Text="Saturation:" Foreground="#ccc" FontSize="12" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="0%" Foreground="#666" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <Grid Grid.Column="1" Height="24" Margin="5,0">
                                                        <Border CornerRadius="2" Height="4" Background="#333" VerticalAlignment="Center"/>
                                                        <Slider Value="{Binding Saturation, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="-4,0" Style="{StaticResource MinimalColorSlider}"/>
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" Text="100%" Foreground="#666" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <TextBlock Text="Lightness:" Foreground="#ccc" FontSize="12" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="0%" Foreground="#666" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <Grid Grid.Column="1" Height="24" Margin="5,0">
                                                        <Border CornerRadius="2" Height="4" Background="#333" VerticalAlignment="Center"/>
                                                        <Slider Value="{Binding Lightness, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="-4,0" Style="{StaticResource MinimalColorSlider}"/>
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" Text="100%" Foreground="#666" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>

                                            <Button Content="Save" 
                                                    Command="{Binding DataContext.SaveChangesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding ElementName=MenuButton}"
                                                    Style="{StaticResource SmoothActionButtonStyle}" Padding="8" Margin="0,0,0,10">
                                                <Button.Triggers>
                                                    <EventTrigger RoutedEvent="Button.Click">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <BooleanAnimationUsingKeyFrames Storyboard.TargetName="MenuButton" Storyboard.TargetProperty="IsChecked">
                                                                    <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False" />
                                                                </BooleanAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <Separator Background="#3F3F41" Margin="0,0,0,10"/>
                                            <Button Content="Delete Playlist" 
        Command="{Binding DataContext.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
        CommandParameter="{Binding}"
        Padding="8">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#FF5555"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid RenderTransformOrigin="0.5,0.5">
                                                                        <Grid.RenderTransform>
                                                                            <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                                                                        </Grid.RenderTransform>

                                                                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    CornerRadius="8" />

                                                                        <Border x:Name="HoverOverlay" Background="#15FFFFFF" CornerRadius="8" Opacity="0"/>
                                                                        <Border x:Name="PressedOverlay" Background="#20000000" CornerRadius="8" Opacity="0"/>

                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                    </Grid>

                                                                    <ControlTemplate.Triggers>
                                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="PreviewMouseDown">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.05"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.05"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="PreviewMouseUp">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>

                                                                        <DataTrigger Binding="{Binding Path=MainWindow.DataContext.IsGlassModeEnabled, Source={x:Static Application.Current}}" Value="True">
                                                                            <Setter TargetName="BgBorder" Property="BorderThickness" Value="1"/>
                                                                            <Setter TargetName="BgBorder" Property="Opacity" Value="0.6"/>
                                                                            <Setter TargetName="BgBorder" Property="BorderBrush">
                                                                                <Setter.Value>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                        <GradientStop Color="#77FFFFFF" Offset="0.0" />
                                                                                        <GradientStop Color="#10FFFFFF" Offset="0.5" />
                                                                                        <GradientStop Color="#15FFFFFF" Offset="1.0" />
                                                                                    </LinearGradientBrush>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Grid x:Name="ContainerGrid" Margin="10,4,32,4" RenderTransformOrigin="0,0.5" Background="Transparent" Opacity="0.8">
                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="StateScale" ScaleX="1" ScaleY="1"/>
                                        </Grid.RenderTransform>

                                        <Border x:Name="BgBorder" 
                                Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" 
                                CornerRadius="10"/>

                                        <ContentPresenter Margin="0"/>

                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <MultiTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation Storyboard.TargetName="ContainerGrid" Storyboard.TargetProperty="Margin" To="10,4,16,4" Duration="0:0:0.15">
                                                            <ThicknessAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </ThicknessAnimation.EasingFunction>
                                                        </ThicknessAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ContainerGrid" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiTrigger.EnterActions>
                                            <MultiTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard FillBehavior="Stop">
                                                        <ThicknessAnimation Storyboard.TargetName="ContainerGrid" Storyboard.TargetProperty="Margin" To="10,4,32,4" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="ContainerGrid" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiTrigger.ExitActions>
                                        </MultiTrigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="TextElement.FontWeight" Value="Bold"/>

                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation Storyboard.TargetName="ContainerGrid" Storyboard.TargetProperty="Margin" To="10,4,0,4" Duration="0:0:0.15">
                                                            <ThicknessAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </ThicknessAnimation.EasingFunction>
                                                        </ThicknessAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ContainerGrid" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard FillBehavior="Stop">
                                                        <ThicknessAnimation Storyboard.TargetName="ContainerGrid" Storyboard.TargetProperty="Margin" To="10,4,32,4" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="ContainerGrid" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            

            <Border Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Height="35" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#181818" Offset="0.0" />
                                            <GradientStop Color="#00181818" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Border Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Bottom" Height="80" IsHitTestVisible="False" Panel.ZIndex="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00181818" Offset="0.0" />
                                            <GradientStop Color="#181818" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

        </Grid>

        <GridSplitter x:Name="PlaylistSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
              Background="#181818" BorderBrush="Transparent" BorderThickness="0"
              ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

        <Grid x:Name="MainContentGrid" Grid.Column="2">

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPlaylistMinimalModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border Background="#181818"/>

                    <Border Background="#252525" Padding="15,10" x:Name="HeaderContainer" CornerRadius="20,0,0,0">
                        <Grid>
                            <Grid x:Name="NormalHeader">
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Click="ToggleSidebarBtn_Click" Style="{StaticResource CircleActionBtnStyle}" Margin="0,0,10,0" ToolTip="Expand/Collapse Sidebar">
                                        <TextBlock x:Name="ToggleSidebarIcon" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Button>
                                    <Button Command="{Binding AddTrackCommand}" Style="{StaticResource CircleActionBtnStyle}" Margin="0,0,10,0" ToolTip="Add Track">
                                    <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="12" FontWeight="Bold"/>
                                </Button>
                                <Button x:Name="OpenSearchBtn" Click="OpenSearchBtn_Click" Style="{StaticResource CircleActionBtnStyle}" ToolTip="Search Tracks">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>

                            <TextBlock x:Name="PlaylistTitleText" Grid.Column="1" Text="{Binding SelectedPlaylist.Name}" 
                               Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"
                               FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Margin="-84,0,0,0"/>
                        </Grid>

                            <Border x:Name="SearchOverlay" CornerRadius="16" HorizontalAlignment="Left" Width="32" Opacity="0" Visibility="Collapsed" Margin="84,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#181818"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#EE2A2A2A" Offset="0.0"/>
                                                            <GradientStop Color="#CC151515" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#44FFFFFF" Offset="0.0" />
                                                            <GradientStop Color="#05FFFFFF" Offset="0.4" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#666" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                <TextBox x:Name="SearchTrackBox" Grid.Column="1" Text="{Binding SearchTrackText, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" Foreground="White" BorderThickness="0" 
                                 Padding="4,6" VerticalContentAlignment="Center" FontWeight="SemiBold" LostFocus="SearchTrackBox_LostFocus"/>

                                    <Button x:Name="CloseSearchBtn" Grid.Column="2" Content="&#xE894;" FontFamily="Segoe MDL2 Assets" 
        Background="Transparent" BorderThickness="0" Cursor="Hand" Width="24" Height="24"
        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" Click="CloseSearchBtn_Click" ToolTip="Close Search">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" Padding="4">
                                                    <TextBlock x:Name="Icon" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="#888888"/>
                                                        </TextBlock.Foreground>
                                                        <TextBlock.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="White" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>

                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#888888" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>

                                                    <EventTrigger RoutedEvent="PreviewMouseDown">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.8" Duration="0:0:0.05"/>
                                                                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.8" Duration="0:0:0.05"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>

                                                    <EventTrigger RoutedEvent="PreviewMouseUp">
                                                        <BeginStoryboard>
                                                            <Storyboard>
