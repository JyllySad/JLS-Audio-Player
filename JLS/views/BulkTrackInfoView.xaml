                                                    <DoubleAnimation Storyboard.TargetName="BgBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="BgBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="BgBorder" Property="Background" Value="#1AA34A"/>
                                            <Setter TargetName="BgBorder" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                            <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter TargetName="BgBorder" Property="BorderThickness" Value="1"/>

                                                <Setter TargetName="BgBorder" Property="BorderBrush">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#55FFFFFF" Offset="0.0" />
                                                            <GradientStop Color="#10FFFFFF" Offset="0.5" />
                                                            <GradientStop Color="#15FFFFFF" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>

                                                <Setter TargetName="BgBorder" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#771DB954" Offset="0.0"/>
                                                            <GradientStop Color="#331DB954" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>

                </ScrollViewer>
                <Border Grid.RowSpan="2" CornerRadius="16" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>

                                    <Setter Property="BorderBrush">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#44FFFFFF" Offset="0.0" />
                                                <GradientStop Color="#0AFFFFFF" Offset="0.15" />
                                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>

                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#15FFFFFF" Offset="0.0" />
                                                <GradientStop Color="#08FFFFFF" Offset="0.15" />
                                                <GradientStop Color="#04FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>