        <Style x:Key="ModernTagTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#141416"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="{StaticResource OnestFont}"/>
            <Setter Property="SelectionBrush" Value="{Binding DataContext.LightColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BgBorder" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#555"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#888"/>
                                <Setter TargetName="BgBorder" Property="Background" Value="#222"/>
                                <Setter TargetName="BgBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="White" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Opacity" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.2">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border Background="#CC000000">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding CloseCommand}"/>
            </Border.InputBindings>
        </Border>

        <Border CornerRadius="16" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1E1E1E"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#1E1E1E" Opacity="0.85"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border.Effect>
                <DropShadowEffect BlurRadius="50" Opacity="0.6" ShadowDepth="0" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="25,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#252525"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="#252525" Opacity="0.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding DataContext.LightColor, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="25,20,25,30">

                        <TextBlock Text="ARTIST" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,16">
                        <TextBox x:Name="ArtistBox" Style="{StaticResource ModernTagTextBoxStyle}" Text="{Binding EditArtistName, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="4,2,30,2"/>
                        <TextBlock IsHitTestVisible="False" Margin="10,2" VerticalAlignment="Center" FontSize="15" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Setter Property="Text" Value="Leave unchanged"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ArtistBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsArtistCleared}" Value="True">
                                            <Setter Property="Text" Value="Will be removed"/>
                                            <Setter Property="Foreground" Value="#FF5555"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Command="{Binding ToggleArtistCommand}" Tag="{Binding IsArtistModified}" Style="{StaticResource TrashUndoBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Remove tag or Revert to default"/>
                    </Grid>

                    <TextBlock Text="ALBUM" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,16">
                        <TextBox x:Name="AlbumBox" Style="{StaticResource ModernTagTextBoxStyle}" Text="{Binding EditAlbumName, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="4,2,30,2"/>
                        <TextBlock IsHitTestVisible="False" Margin="10,2" VerticalAlignment="Center" FontSize="14" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Setter Property="Text" Value="Leave unchanged"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=AlbumBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAlbumCleared}" Value="True">
                                            <Setter Property="Text" Value="Will be removed"/>
                                            <Setter Property="Foreground" Value="#FF5555"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Command="{Binding ToggleAlbumCommand}" Tag="{Binding IsAlbumModified}" Style="{StaticResource TrashUndoBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Remove tag or Revert to default"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="GENRE" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,16">
                                <TextBox x:Name="GenreBox" Style="{StaticResource ModernTagTextBoxStyle}" Text="{Binding EditGenre, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="4,2,30,2"/>
                                <TextBlock IsHitTestVisible="False" Margin="10,2" VerticalAlignment="Center" FontSize="14" FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Setter Property="Text" Value="Leave unchanged"/>
                                            <Setter Property="Foreground" Value="#666"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=GenreBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGenreCleared}" Value="True">
                                                    <Setter Property="Text" Value="Will be removed"/>
                                                    <Setter Property="Foreground" Value="#FF5555"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Command="{Binding ToggleGenreCommand}" Tag="{Binding IsGenreModified}" Style="{StaticResource TrashUndoBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Remove tag or Revert to default"/>
                            </Grid>

                            <TextBlock Text="YEAR" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,16">
                                <TextBox x:Name="YearBox" Style="{StaticResource ModernTagTextBoxStyle}" Text="{Binding EditTrackYear, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="4,2,30,2" MaxLength="4"/>
                                <TextBlock IsHitTestVisible="False" Margin="10,2" VerticalAlignment="Center" FontSize="14" FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Setter Property="Text" Value="Leave unchanged"/>
                                            <Setter Property="Foreground" Value="#666"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=YearBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsYearCleared}" Value="True">
                                                    <Setter Property="Text" Value="Will be removed"/>
                                                    <Setter Property="Foreground" Value="#FF5555"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Command="{Binding ToggleYearCommand}" Tag="{Binding IsYearModified}" Style="{StaticResource TrashUndoBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Remove tag or Revert to default"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <TextBlock Text="TRACK COVER" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                            <Grid x:Name="EditCoverGrid">

                                <Button Command="{Binding ChangeCoverArtCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" Margin="0">
                                    <Button.Template>
