                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Panel.ZIndex="10" IsHitTestVisible="False" CornerRadius="20,0,0,0" Margin="0,0,0,-60">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{Binding DominantColor}" Offset="0.0" />
                                    <GradientStop Color="{Binding DominantColor}" Offset="0.58" />
                                    <GradientStop Color="#001E1E1E" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Grid.Row="0" Margin="20,10,20,5" Panel.ZIndex="11" x:Name="AlbumTracksHeaderGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <StackPanel.Resources>
                                        <Style x:Key="MinimalCircleActionBtnStyle" TargetType="Button">
                                            <Setter Property="Width" Value="32"/>
                                            <Setter Property="Height" Value="32"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Foreground" Value="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform>
                                                                <ScaleTransform ScaleX="1" ScaleY="1" x:Name="BtnScale"/>
                                                            </Grid.RenderTransform>
                                                            <Ellipse x:Name="BaseEllipse" Fill="#26000000"/>
                                                            <Ellipse x:Name="HoverOverlay" Fill="#20FFFFFF" Opacity="0"/>
                                                            <Ellipse x:Name="PressedOverlay" Fill="#20000000" Opacity="0"/>
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <EventTrigger RoutedEvent="MouseEnter">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.15">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.15">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <EventTrigger RoutedEvent="MouseLeave">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <EventTrigger RoutedEvent="PreviewMouseDown">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05"/>
                                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.05"/>
                                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.05"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <EventTrigger RoutedEvent="PreviewMouseUp">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.15">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.15">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter TargetName="BaseEllipse" Property="StrokeThickness" Value="1"/>
                                                                <Setter TargetName="BaseEllipse" Property="Stroke">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="#44FFFFFF" Offset="0.0" />
                                                                            <GradientStop Color="#05FFFFFF" Offset="0.4" />
                                                                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>

                                    <Button Click="ToggleSidebarBtn_Click" Style="{StaticResource MinimalCircleActionBtnStyle}" Margin="0,0,10,0" ToolTip="Expand/Collapse Sidebar">
                                        <TextBlock x:Name="ToggleSidebarIcon" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Button>
                                    <Button x:Name="OpenTrackSearchBtn" Click="OpenTrackSearchBtn_Click" Style="{StaticResource MinimalCircleActionBtnStyle}" ToolTip="Search Tracks">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>

                                <Border x:Name="TrackSearchOverlay" CornerRadius="16" HorizontalAlignment="Left" Width="32" Height="32" Opacity="0" Visibility="Collapsed" Margin="42,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#26000000"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#442A2A2A" Offset="0.0"/>
                                                                <GradientStop Color="#22151515" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#44FFFFFF" Offset="0.0" />
                                                                <GradientStop Color="#05FFFFFF" Offset="0.4" />
                                                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.7" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                        <TextBox x:Name="TrackSearchBox" Grid.Column="1" Text="{Binding SearchTrackText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" CaretBrush="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" BorderThickness="0" Padding="4,6" VerticalContentAlignment="Center" FontWeight="SemiBold" LostFocus="TrackSearchBox_LostFocus"/>

                                        <Button Grid.Column="2" Content="&#xE894;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" Click="CloseTrackSearchBtn_Click" ToolTip="Close Search">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" Padding="4">
                                                        <TextBlock x:Name="Icon" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.6">
                                                            <TextBlock.RenderTransform>
                                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding ShowFullCoverCommand}" VerticalAlignment="Top" Margin="0,-10,0,10" Width="220" Height="220" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>

                                                <Border CornerRadius="16" Margin="-15" Opacity="0.75" IsHitTestVisible="False">

                                                    <Border.CacheMode>
                                                        <BitmapCache EnableClearType="False" RenderAtScale="0.2"/>
                                                    </Border.CacheMode>

                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding AlbumCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <BlurEffect Radius="45" RenderingBias="Performance"/>
                                                    </Border.Effect>
                                                </Border>

                                                <Grid RenderTransformOrigin="0.5,0.5">

                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="CoverScale" ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>

                                                    <Border Background="Black" CornerRadius="8" Opacity="0.5" Margin="0,10,0,-10">
                                                        <Border.Effect>
                                                            <BlurEffect Radius="30" RenderingBias="Performance"/>
                                                        </Border.Effect>
                                                    </Border>

                                                    <Grid>
                                                        <Border x:Name="PlaceholderBackground" Background="#181818" CornerRadius="8" Visibility="Collapsed">
                                                            <TextBlock Text="&#xE189;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border CornerRadius="8">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding AlbumCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Grid>

                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding AlbumCover}" Value="{x:Null}">
                                                    <Setter TargetName="PlaceholderBackground" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Grid Grid.Column="1" Margin="32,0,0,30" VerticalAlignment="Center">
                                    <StackPanel>

                                        <TextBlock Text="{Binding SelectedAlbum.Title}" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" FontSize="48" FontWeight="Black" Margin="0,0,45,6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding SelectedAlbum.Artist}" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.85" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,18" IsHitTestVisible="False">

                                            <StackPanel.Resources>
                                                <Style x:Key="AlbumGlassOverlay" TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#55FFFFFF" Offset="0.0" />
                                                                        <GradientStop Color="#10FFFFFF" Offset="0.5" />
                                                                        <GradientStop Color="#15FFFFFF" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
                                                                        <GradientStop Color="#08FFFFFF" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Resources>

                                            <Grid Height="24" Margin="0,0,6,0" Visibility="{Binding IsAlbumFormatVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border CornerRadius="6" Background="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.15"/>
                                                <Border Style="{StaticResource AlbumGlassOverlay}"/>
                                                <TextBlock Text="{Binding AlbumFormat}" 
                   Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" 
                   Opacity="0.8" FontSize="14" FontWeight="Bold"
                   VerticalAlignment="Center" Padding="8,0"/>
                                            </Grid>

                                            <Grid Height="24" Margin="0,0,6,0" Visibility="{Binding IsAlbumSampleRateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border CornerRadius="6" Background="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.15"/>
                                                <Border Style="{StaticResource AlbumGlassOverlay}"/>
                                                <TextBlock Text="{Binding AlbumSampleRate}" 
                   Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" 
                   Opacity="0.8" FontSize="14" FontWeight="Bold"
                   VerticalAlignment="Center" Padding="8,0"/>
                                            </Grid>

                                            <Grid Height="24" Margin="0,0,0,0" Visibility="{Binding IsAlbumBitDepthVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border CornerRadius="6" Background="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.15"/>
                                                <Border Style="{StaticResource AlbumGlassOverlay}"/>
                                                <TextBlock Text="{Binding AlbumBitDepth}" 
                   Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" 
                   Opacity="0.8" FontSize="14" FontWeight="Bold"
                   VerticalAlignment="Center" Padding="8,0"/>
                                            </Grid>

                                        </StackPanel>

                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding SelectedAlbum.Year}" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.65" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AlbumDurationInfo}" Foreground="{Binding DominantColor, Converter={StaticResource ColorToContrastBrushConverter}}" Opacity="0.60" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <ListView x:Name="TracksListView" Grid.Row="1" ItemsSource="{Binding SelectedAlbum.Items}" 
                              Background="Transparent" BorderThickness="0"
                              Margin="4,0,2,0" Padding="0"
                                  SelectionMode="Extended"
          PreviewMouseRightButtonUp="ListView_PreviewMouseRightButtonUp"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.ScrollUnit="Pixel">

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel>
                                        <VirtualizingStackPanel.Style>
                                            <Style TargetType="VirtualizingStackPanel">
                                                <Setter Property="Margin" Value="0,10,0,0"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                            <Condition Binding="{Binding DataContext.IsMinimalBottomPanelEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Margin" Value="0,10,0,200"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                            <Condition Binding="{Binding DataContext.IsMinimalBottomPanelEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Margin" Value="0,10,0,110"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </VirtualizingStackPanel.Style>
                                    </VirtualizingStackPanel>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#E0E0E0"/>

                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Opacity" Value="0.85"/>

                                    <Setter Property="Height" Value="46"/>
                                    <Setter Property="Margin" Value="0,2,2,2"/>
                                    <Setter Property="Padding" Value="15,0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>

                                    <Setter Property="ContextMenu" Value="{StaticResource TrackContextMenu}"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{Binding DataContext.DarkColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Opacity" Value="1.0"/>
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" 
                          Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                          CommandParameter="{Binding}"/>
                                        </Grid.InputBindings>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="30">
                                            <TextBlock Text="{Binding DisplayTrackNumber}" Foreground="#888" FontSize="14" HorizontalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Grid HorizontalAlignment="Center" Height="14">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="2"/>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="2"/>
                                                    <ColumnDefinition Width="3"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{Binding DataContext.LightColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                        <Setter Property="CornerRadius" Value="2"/>
                                                        <Setter Property="Height" Value="14"/>
                                                        <Setter Property="RenderTransformOrigin" Value="0.5, 1"/>
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleY="0.2"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Grid.Resources>

                                                <Border Grid.Column="0">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard Name="Anim1">
                                                                            <Storyboard Timeline.DesiredFrameRate="24" RepeatBehavior="Forever" AutoReverse="True">
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.3" To="1.0" Duration="0:0:0.35" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="Anim1"/>
                                                                        <BeginStoryboard>
                                                                            <Storyboard Timeline.DesiredFrameRate="24">
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.2" Duration="0:0:0.2">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <Border Grid.Column="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard Name="Anim2">
                                                                            <Storyboard Timeline.DesiredFrameRate="24" RepeatBehavior="Forever" AutoReverse="True">
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="0.2" Duration="0:0:0.45" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="Anim2"/>
                                                                        <BeginStoryboard>
                                                                            <Storyboard Timeline.DesiredFrameRate="24">
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.2" Duration="0:0:0.2">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <Border Grid.Column="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard Name="Anim3">
                                                                            <Storyboard Timeline.DesiredFrameRate="24" RepeatBehavior="Forever" AutoReverse="True">
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.4" To="0.9" Duration="0:0:0.25" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="Anim3"/>
                                                                        <BeginStoryboard>
                                                                            <Storyboard Timeline.DesiredFrameRate="24">
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.2" Duration="0:0:0.2">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Foreground" Value="{Binding DataContext.LightColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="DurationTextBlock" Text="{Binding Duration}" Foreground="#888" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <Button x:Name="MoreOptionsBtn" 
                    Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#888"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    VerticalAlignment="Center" HorizontalAlignment="Right"
                    Opacity="0" IsHitTestVisible="False"
                    Click="MoreOptionsBtn_Click"
                    Margin="0,0,-8,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" Padding="12,4" CornerRadius="4">
                                                            <TextBlock x:Name="Icon" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" 
                                       FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                                                <TextBlock.RenderTransform>
                                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                                </TextBlock.RenderTransform>
                                                            </TextBlock>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <EventTrigger RoutedEvent="MouseEnter">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="White" Duration="0:0:0.2">
                                                                            <ColorAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                            </ColorAnimation.EasingFunction>
                                                                        </ColorAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.25" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.25" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <EventTrigger RoutedEvent="MouseLeave">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#888888" Duration="0:0:0.2">
                                                                            <ColorAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                            </ColorAnimation.EasingFunction>
                                                                        </ColorAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <EventTrigger RoutedEvent="PreviewMouseDown">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.05"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.05"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <EventTrigger RoutedEvent="PreviewMouseUp">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.25" Duration="0:0:0.15">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.25" Duration="0:0:0.15">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                            <Setter TargetName="MoreOptionsBtn" Property="IsHitTestVisible" Value="True"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="DurationTextBlock" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="MoreOptionsBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="DurationTextBlock" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="MoreOptionsBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                    </ListView>
                        <Border Grid.Row="1" VerticalAlignment="Top" Height="20" Margin="4,0,2,0" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1E1E1E" Offset="0.0" />
                                    <GradientStop Color="#001E1E1E" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border Grid.Row="1" VerticalAlignment="Bottom" Height="60" Margin="4,0,2,0" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#001E1E1E" Offset="0.0" />
                                                        <GradientStop Color="#1E1E1E" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        

    </Grid>
</UserControl>