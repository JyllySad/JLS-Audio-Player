        <ContextMenu x:Key="AlbumItemContextMenu">
            <MenuItem Header="Rename" 
                  Command="{Binding PlacementTarget.Tag.RenameAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" Foreground="White" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator Background="#333" Margin="5,0"/>

            <MenuItem Header="Delete" Foreground="#FF5555"
                  Command="{Binding PlacementTarget.Tag.DeleteAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#FF5555" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="TrackContextMenu">
            <MenuItem Header="Add to Playlist" 
                  ItemsSource="{Binding PlacementTarget.Tag.PlaylistManager.Playlists, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource PlaylistIconGeometry}" Fill="White" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                </MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}"/>
                        <Setter Property="IsCheckable" Value="True"/>
                        <Setter Property="IsChecked">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource PlaylistTrackMultiConverter}" Mode="OneWay">
                                    <Binding Path="."/>
                                    <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Command" Value="{Binding PlacementTarget.Tag.TogglePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Setter Property="CommandParameter">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource PlaylistTrackMultiConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>

            <Separator/>

            <MenuItem Header="Show in Explorer" 
                  Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext.FullPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource ExplorerIconGeometry}" Fill="White" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Track Information" 
                  CommandParameter="{Binding PlacementTarget.DataContext.FullPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <EventSetter Event="MenuItem.Click" Handler="TrackInfoMenuItem_Click"/>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="BulkContextMenu">
            <MenuItem Header="Add all to Playlist" ItemsSource="{Binding PlaylistManager.Playlists}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}"/>
                        <EventSetter Event="Click" Handler="BulkAddToPlaylistMenuItem_Click"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
                <MenuItem.Icon>
                    <Path Data="{StaticResource PlaylistIconGeometry}" Fill="White" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Edit Tags for All Files" Click="BulkEditTagsMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="White" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="300" MinWidth="200" MaxWidth="600"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarContainer" Grid.Column="0" Background="#181818" BorderBrush="#2D2D30" BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="16" Height="32" Panel.ZIndex="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1E1E1E"/>
                            <Setter Property="Margin" Value="10,10,10,1"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">

                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#BB2A2A2A" Offset="0.0"/>
                                                <GradientStop Color="#99151515" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>

                                    <Setter Property="Margin" Value="14,10,26,0"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>

                                    <Setter Property="BorderThickness" Value="0"/>

                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid x:Name="SearchAlbumRootGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border Background="Black" CornerRadius="16"
                            Width="{Binding ActualWidth, ElementName=SearchAlbumRootGrid}" 
                            Height="{Binding ActualHeight, ElementName=SearchAlbumRootGrid}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Grid.OpacityMask>

                        

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="GotKeyboardFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="AlbumSearchHighlight" 
                                     Storyboard.TargetProperty="Opacity" 
                                     To="0.08" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="LostKeyboardFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="AlbumSearchHighlight" 
                                     Storyboard.TargetProperty="Opacity" 
                                     To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <Border Grid.ColumnSpan="3" IsHitTestVisible="False" CornerRadius="15" BorderThickness="1,1,1,0" Panel.ZIndex="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsGlassModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="BorderBrush">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#44FFFFFF" Offset="0.0" />
                                                        <GradientStop Color="#05FFFFFF" Offset="0.4" />
                                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Border x:Name="AlbumSearchHighlight" Grid.ColumnSpan="3" Background="White" Opacity="0" CornerRadius="16" IsHitTestVisible="False"/>

                        <ToggleButton Grid.Column="0" IsChecked="{Binding ShowAlbumCovers}" 
                                      Background="Transparent" BorderThickness="0" Cursor="Hand" 
                                      Width="28" Height="28" Margin="1,0,0,0" ToolTip="Show/Hide album covers">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                                        </Grid.RenderTransform>

                                        <Ellipse x:Name="HoverOverlay" Fill="#20FFFFFF" Opacity="0"/>

                                        <Grid Width="14" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border x:Name="MiniThumb" Width="5" Height="10" CornerRadius="1.5" 
                                                    Background="White" HorizontalAlignment="Left" Opacity="0"/>

                                            <StackPanel x:Name="TextLines" VerticalAlignment="Center" HorizontalAlignment="Right" Width="14">
                                                <Border x:Name="Line1" Height="1.5" CornerRadius="0.75" Margin="0,0,0,3" HorizontalAlignment="Left" Width="14">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#888888"/>
                                                    </Border.Background>
                                                </Border>
                                                <Border x:Name="Line2" Height="1.5" CornerRadius="0.75" HorizontalAlignment="Left" Width="9">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#888888"/>
                                                    </Border.Background>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                    <ColorAnimation Storyboard.TargetName="Line1" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="White" Duration="0:0:0.15"/>
                                                    <ColorAnimation Storyboard.TargetName="Line2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="White" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                    <ColorAnimation Storyboard.TargetName="Line1" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#888888" Duration="0:0:0.15"/>
                                                    <ColorAnimation Storyboard.TargetName="Line2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#888888" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="MiniThumb" Property="Opacity" Value="1"/>
                                            <Setter TargetName="Line1" Property="Background" Value="White"/>
                                            <Setter TargetName="Line2" Property="Background" Value="White"/>
                                            <Setter TargetName="TextLines" Property="Width" Value="7"/>
                                        </Trigger>

                                        <EventTrigger RoutedEvent="PreviewMouseDown">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.85" Duration="0:0:0.05"/>
                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.85" Duration="0:0:0.05"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="PreviewMouseUp">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" 
                                   Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0"/>

                        <TextBox x:Name="SearchAlbumBox" Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" Foreground="White" BorderThickness="0" 
                                 Padding="8,6,30,6" VerticalContentAlignment="Center" FontWeight="SemiBold"
                                 TextChanged="SearchBox_TextChanged"/>

                        <Button x:Name="ClearSearchBtn" Grid.Column="2" Content="&#xE894;" FontFamily="Segoe MDL2 Assets" 
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                Opacity="0" Visibility="Collapsed" Click="ClearSearchBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="4">
                                        <TextBlock x:Name="Icon" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" 
                                                   RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="#888888"/>
                                            </TextBlock.Foreground>
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="White" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#888888" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="PreviewMouseDown">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.8" Duration="0:0:0.05"/>
                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.8" Duration="0:0:0.05"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="PreviewMouseUp">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
