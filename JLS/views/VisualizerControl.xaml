<UserControl x:Class="JLS.Views.VisualizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{Binding DarkColor}"
             MouseRightButtonUp="UserControl_MouseRightButtonUp"
             MouseMove="UserControl_MouseMove">
    <Grid>
        <Rectangle x:Name="ProgressOverlay" 
                   HorizontalAlignment="Left" 
                   Fill="{Binding LightColor}" 
                   Opacity="0.08"
                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <Canvas x:Name="DrawCanvas" SizeChanged="DrawCanvas_SizeChanged" />

        <Grid x:Name="CloseButtonContainer" HorizontalAlignment="Left" VerticalAlignment="Top">

            <Button Command="{Binding ToggleOverlayVisualizerCommand}" 
                    Margin="20" Width="45" Height="45" 
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Opacity="0.15" RenderTransformOrigin="0.5,0.5">

                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Button.RenderTransform>

                <TextBlock Text="&#xE711;"
                           FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.15" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </Grid>
    </Grid>
</UserControl>