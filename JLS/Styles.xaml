                            </StackPanel>
                        </CheckBox>

                        <StackPanel IsEnabled="{Binding IsVisualizerStyleEnabled}">
                            <TextBlock Text="Visualizer Style" FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,10"/>
                            <ComboBox Height="36"
