                </Border>

                <Border Style="{StaticResource SettingsCardStyle}" Width="330">
                    <Border.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{DynamicResource OnestFont}"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Resources>

                    <StackPanel>
                        <TextBlock Text="BOTTOM PANEL" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                        <CheckBox IsChecked="{Binding IsMinimalBottomPanelEnabled}" Style="{StaticResource PlayerCheckBoxStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Minimal Mode" VerticalAlignment="Center" Margin="0,0,8,0"/>
