                                    <TextBlock Text="Hide Controls when Playing" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ContentControl Style="{StaticResource HelpIconStyle}" ToolTip="Works only for Waveform Style."/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <StackPanel IsEnabled="{Binding IsLayoutOrderEnabled}">
                            <TextBlock Text="Layout Order" FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,10"/>
