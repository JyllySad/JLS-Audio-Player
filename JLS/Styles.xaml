                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Font Size" FontSize="12" Foreground="#777" Margin="0,0,0,5"/>
                                <ComboBox Height="36" ItemsSource="{Binding FontOptions}" SelectedItem="{Binding TreeFontSize}" Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>
