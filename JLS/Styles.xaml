                                <ContentControl Style="{StaticResource HelpIconStyle}" ToolTip="The fluid smoke reacts to bass and beat drops in the tracks."/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding IsCleanModeEnabled}" Style="{StaticResource PlayerCheckBoxStyle}" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Clean Mode" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentControl Style="{StaticResource HelpIconStyle}" ToolTip="Hides the title bar, and also hides the now playing close button&#x0a;and mouse cursor when inactive."/>
                            </StackPanel>
