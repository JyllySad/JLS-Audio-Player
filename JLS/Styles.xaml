                                        <DataTrigger Binding="{Binding SelectedControlStyle}" Value="Animated">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <CheckBox IsChecked="{Binding IsAutoHideControlsEnabled}" Style="{StaticResource PlayerCheckBoxStyle}">
