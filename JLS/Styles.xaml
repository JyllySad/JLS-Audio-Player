        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter x:Name="IconPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" x:Name="IconScale"/>
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.2" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.2" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="TextElement.Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Explorer"/>
                    <Condition Binding="{Binding ActiveSidebarItem}" Value="Explorer"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{Binding LightColor}"/>

                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="40" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="1.0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>

                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="36" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Playlists"/>
                    <Condition Binding="{Binding ActiveSidebarItem}" Value="Playlists"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{Binding LightColor}"/>

                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="40" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="1.0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>

                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="36" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="SavedAlbums"/>
                    <Condition Binding="{Binding ActiveSidebarItem}" Value="SavedAlbums"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{Binding LightColor}"/>

                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="40" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="1.0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>

                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="36" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Settings"/>
                    <Condition Binding="{Binding ActiveSidebarItem}" Value="Settings"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{Binding LightColor}"/>

                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="40" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="1.0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>

                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="36" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Info"/>
                    <Condition Binding="{Binding ActiveSidebarItem}" Value="Info"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{Binding LightColor}"/>

                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="40" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="1.0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>

                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="36" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>

        </Style.Triggers>
    </Style>

    <Style x:Key="SettingsTabBtnStyle" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#A0A0A0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="25,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="4"/>

                        <Border x:Name="HoverLayer" Background="#252525" CornerRadius="4" Opacity="0"/>

                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                      VerticalAlignment="Center" 
                                      Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>

                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="TextElement.Foreground" Value="White"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BgBorder" Property="Background" Value="#1A1A1C"/>
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsActionBtn" TargetType="Button">
        <Setter Property="Background" Value="#2D2D30"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>

                        <Border x:Name="HoverLayer" Background="#3E3E42" CornerRadius="4" Opacity="0"/>

                        <Border x:Name="PressedLayer" Background="#1E1E20" CornerRadius="4" Opacity="0"/>

                        <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="ContentSite" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.25" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ContentSite" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.25" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                    <DoubleAnimation Storyboard.TargetName="ContentSite" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ContentSite" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="ContentSite" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#E0E0E0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Margin="4,2">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="2"/>

                        <Border x:Name="HoverGlow" Background="#353538" CornerRadius="2" Opacity="0"/>

                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="BgBorder" Property="Background" Value="#45454A"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" 
                                                     Storyboard.TargetProperty="Opacity" 
                                                     To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" 
                                                     Storyboard.TargetProperty="Opacity" 
                                                     To="0" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource OnestFont}"/>
            </Style>
        </Style.Resources>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#252525"/>
        <Setter Property="BorderBrush" Value="#3F3F41"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" 
                                  BorderBrush="{TemplateBinding BorderBrush}" 
                                  Background="{TemplateBinding Background}" 
                                  BorderThickness="{TemplateBinding BorderThickness}" 
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>

                                        <Border x:Name="HoverGlow" Background="#353538" CornerRadius="4" Opacity="0"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="1" Background="Transparent">
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,35,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border x:Name="DropDownBorder" Background="#252525" BorderThickness="2" BorderBrush="#3F3F41" CornerRadius="4" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}">
                                <ScrollViewer Margin="0,4" SnapsToDevicePixels="True" MaxHeight="250">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Foreground" Value="#88FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>



    <Style x:Key="MinimalControlBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1.0"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="SoundSettingsTemplate">
        <StackPanel Margin="10,0,0,0" Style="{StaticResource FadeInLoadedStyle}">
            <TextBlock Text="Sound" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,0,25"/>

            <Border Style="{StaticResource SettingsCardStyle}" HorizontalAlignment="Left" MinWidth="560">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Output Device" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </StackPanel>

                    <ComboBox Width="450" HorizontalAlignment="Left" Height="36" Margin="0,0,0,25"
                              ItemsSource="{Binding AvailableDevices}" 
                              SelectedItem="{Binding SelectedDevice}"
                              Style="{StaticResource DarkComboBoxStyle}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Track Transition Mode" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ContentControl Style="{StaticResource HelpIconStyle}" ToolTip="Crossfade overlaps tracks.&#x0a;Fade In/Out adds a smooth silence gap."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <ComboBox Width="280" HorizontalAlignment="Left" Height="36"
                                  ItemsSource="{Binding TransitionModes}" 
                                  SelectedValue="{Binding SelectedTransitionMode}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>

                        <StackPanel Orientation="Horizontal" Margin="25,0,0,0" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="-20"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTransitionDurationVisible}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-20" Duration="0:0:0.2"/>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Duration:" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Background="#2D2D30" CornerRadius="6" Height="36">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="32" Command="{Binding DecreaseTransitionDurationCommand}"/>
                                    <TextBlock Text="{Binding TransitionDuration, StringFormat='{}{0:F1}s'}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Width="44" TextAlignment="Center"/>
                                    <Button Content="+" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="32" Command="{Binding IncreaseTransitionDurationCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding IsGaplessPlaybackEnabled}" 
                              IsEnabled="{Binding IsGaplessAllowed}"
                              Style="{StaticResource PlayerCheckBoxStyle}" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Gapless Playback (Only WASAPI or ASIO)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ContentControl Style="{StaticResource HelpIconStyle}" ToolTip="Only works in Normal track transition mode.&#x0a;Best for properly mastered albums."/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding IsSkipSilenceEnabled}" 
                              IsEnabled="{Binding IsWasapiOrAsio}"
                              Style="{StaticResource PlayerCheckBoxStyle}" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Skip Silence (Only WASAPI or ASIO)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ContentControl Style="{StaticResource HelpIconStyle}" ToolTip="Skips silence at the start and end of track."/>
                        </StackPanel>
                    </CheckBox>

                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="HotkeysSettingsTemplate">
        <StackPanel Margin="10,0,0,0" Style="{StaticResource FadeInLoadedStyle}">
            <TextBlock Text="Hotkeys" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,0,25"/>

            <Border Style="{StaticResource SettingsCardStyle}" HorizontalAlignment="Left" MinWidth="560">
                <StackPanel>

                    <CheckBox IsChecked="{Binding IsMediaKeysEnabled}" Style="{StaticResource PlayerCheckBoxStyle}" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Enable Windows Media Keys" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ContentControl Style="{StaticResource HelpIconStyle}" ToolTip="Allows you to control playback using the dedicated media buttons&#x0a;(Play/Pause, Next, Prev) on your devices."/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Content="Enable Global Hotkeys" 
                          IsChecked="{Binding IsGlobalHotkeysEnabled}" 
                          Style="{StaticResource PlayerCheckBoxStyle}" Margin="0,0,0,25"/>

                    <StackPanel IsEnabled="{Binding IsGlobalHotkeysEnabled}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Click a button below to reassign. Press ESC to cancel recording."
                               Foreground="#777" FontSize="14" Margin="0,0,0,25"/>

                        <ItemsControl ItemsSource="{Binding HotkeysList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" Margin="0,0,0,12">

                                        <Border x:Name="HoverBg" Background="#28282B" CornerRadius="8" Opacity="0" Margin="-12,-8,-12,-8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding ActionName}" Foreground="#E0E0E0" FontSize="16" VerticalAlignment="Center"/>

                                            <Border x:Name="VolUpRegulator" Grid.Column="1" Background="#2D2D30" CornerRadius="6" Height="32" Visibility="Collapsed" Margin="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="-" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="28" Height="32" Command="{Binding DataContext.DecreaseHotkeyVolumeUpCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                                    <TextBlock Text="{Binding DataContext.HotkeyVolumeUpPercent, RelativeSource={RelativeSource AncestorType=ScrollViewer}, StringFormat='{}{0}%'}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Width="42" TextAlignment="Center"/>
                                                    <Button Content="+" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="28" Height="32" Command="{Binding DataContext.IncreaseHotkeyVolumeUpCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="VolDownRegulator" Grid.Column="1" Background="#2D2D30" CornerRadius="6" Height="32" Visibility="Collapsed" Margin="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="-" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="28" Height="32" Command="{Binding DataContext.DecreaseHotkeyVolumeDownCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                                    <TextBlock Text="{Binding DataContext.HotkeyVolumeDownPercent, RelativeSource={RelativeSource AncestorType=ScrollViewer}, StringFormat='{}{0}%'}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Width="42" TextAlignment="Center"/>
                                                    <Button Content="+" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="28" Height="32" Command="{Binding DataContext.IncreaseHotkeyVolumeDownCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="SkipFwdRegulator" Grid.Column="1" Background="#2D2D30" CornerRadius="6" Height="32" Visibility="Collapsed" Margin="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="-" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="28" Height="32" Command="{Binding DataContext.DecreaseHotkeySkipForwardCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                                    <TextBlock Text="{Binding DataContext.HotkeySkipForwardSeconds, RelativeSource={RelativeSource AncestorType=ScrollViewer}, StringFormat='{}{0}s'}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Width="42" TextAlignment="Center"/>
                                                    <Button Content="+" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="28" Height="32" Command="{Binding DataContext.IncreaseHotkeySkipForwardCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="SkipBwdRegulator" Grid.Column="1" Background="#2D2D30" CornerRadius="6" Height="32" Visibility="Collapsed" Margin="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="-" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="28" Height="32" Command="{Binding DataContext.DecreaseHotkeySkipBackwardCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                                    <TextBlock Text="{Binding DataContext.HotkeySkipBackwardSeconds, RelativeSource={RelativeSource AncestorType=ScrollViewer}, StringFormat='{}{0}s'}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Width="42" TextAlignment="Center"/>
                                                    <Button Content="+" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="28" Height="32" Command="{Binding DataContext.IncreaseHotkeySkipBackwardCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                                </StackPanel>
                                            </Border>

                                            <Button Grid.Column="2" 
                                                Content="{Binding DisplayText}" 
                                                Command="{Binding DataContext.StartRecordingHotkeyCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" 
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource HotkeyBtnStyle}"/>
                                        </Grid>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                        <DataTrigger Binding="{Binding Id}" Value="103">
                                            <Setter TargetName="VolUpRegulator" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Id}" Value="104">
                                            <Setter TargetName="VolDownRegulator" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Id}" Value="105">
                                            <Setter TargetName="SkipFwdRegulator" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Id}" Value="106">
                                            <Setter TargetName="SkipBwdRegulator" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="InterfaceSettingsTemplate">
        <StackPanel Margin="10,0,0,0" Style="{StaticResource FadeInLoadedStyle}">
            <TextBlock Text="Interface" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,0,25"/>

            <controls:MasonryPanel ColumnWidth="350">

                <Border Style="{StaticResource SettingsCardStyle}" Width="330">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                        <TextBlock Text="UI Scale" FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                            <Border Background="#2D2D30" CornerRadius="6" Height="36">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="32" Command="{Binding DecreaseScaleCommand}"/>
                                    <TextBlock Text="{Binding UiScale, StringFormat='{}{0:P0}'}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Width="55" TextAlignment="Center"/>
                                    <Button Content="+" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="32" Command="{Binding IncreaseScaleCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Color Mode" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ContentControl Style="{StaticResource HelpIconStyle}" ToolTip="Algorithm variant for extracting accent and background colors&#x0a;from the track cover, or a selected static color."/>
                        </StackPanel>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" Height="36" VerticalAlignment="Center"
                                          ItemsSource="{Binding ColorExtractionAlgorithms}" 
                                          SelectedValue="{Binding SelectedColorExtractionAlgorithm}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value"
                                          Style="{StaticResource DarkComboBoxStyle}" 
                                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>

                            <Grid Grid.Column="1" HorizontalAlignment="Right">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="Width" Value="0"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform X="-20"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFixedColorSelected}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                            </ObjectAnimationUsingKeyFrames>

                                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="46" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>

                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>

                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>

                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-20" Duration="0:0:0.2"/>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <ToggleButton x:Name="FixedColorToggle" 
                                                  Width="36" Height="36" Margin="10,0,0,0"
                                                  IsChecked="{Binding IsFixedColorPopupOpen, Mode=TwoWay}"
                                                  Command="{Binding OpenFixedColorPopupCommand}"
                                                  Cursor="Hand" ToolTip="Adjust Fixed Color">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ColorBtnBorder" Background="{Binding FixedPrimaryColorBrush}" 
                                                        CornerRadius="4" BorderBrush="#3F3F41" BorderThickness="1"
                                                        RenderTransformOrigin="0.5,0.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ColorBtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.15">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="ColorBtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.15">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ColorBtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="ColorBtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ColorBtnBorder" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup IsOpen="{Binding IsFixedColorPopupOpen, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=FixedColorToggle}" Placement="Bottom" HorizontalOffset="-184" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="#252525" BorderBrush="#3F3F41" BorderThickness="0" CornerRadius="6" Padding="15" Width="220">
                                        <StackPanel>
                                            <TextBlock Text="COLOR SETTINGS" Foreground="#888" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                                            <TextBlock Text="Color:" Foreground="#ccc" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="2"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="1" Height="24" Margin="5,0">
                                                    <Border CornerRadius="2" Height="4" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#FF0000" Offset="0.0" />
                                                                <GradientStop Color="#FFFF00" Offset="0.16" />
                                                                <GradientStop Color="#00FF00" Offset="0.33" />
                                                                <GradientStop Color="#00FFFF" Offset="0.5" />
                                                                <GradientStop Color="#0000FF" Offset="0.66" />
                                                                <GradientStop Color="#FF00FF" Offset="0.83" />
                                                                <GradientStop Color="#FF0000" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Slider Value="{Binding FixedColorHue, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="360" VerticalAlignment="Center" Margin="-9,0" Style="{StaticResource MinimalColorSlider}"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Text="Saturation:" Foreground="#ccc" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="0%" Foreground="#666" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Grid Grid.Column="1" Height="24" Margin="5,0">
                                                    <Border CornerRadius="2" Height="4" Background="#333" VerticalAlignment="Center"/>
                                                    <Slider Value="{Binding FixedColorSaturation, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="-4,0" Style="{StaticResource MinimalColorSlider}"/>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="100%" Foreground="#666" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="Lightness:" Foreground="#ccc" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,20">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="0%" Foreground="#666" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Grid Grid.Column="1" Height="24" Margin="5,0">
                                                    <Border CornerRadius="2" Height="4" Background="#333" VerticalAlignment="Center"/>
                                                    <Slider Value="{Binding FixedColorLightness, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="-4,0" Style="{StaticResource MinimalColorSlider}"/>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="100%" Foreground="#666" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelFixedColorCommand}" Style="{StaticResource SmoothActionButtonStyle}" Height="30" Padding="0"/>
                                                <Button Grid.Column="2" Content="Save" Command="{Binding SaveFixedColorCommand}" Style="{StaticResource SmoothActionButtonStyle}" Height="30" Padding="0" Background="{Binding FixedPrimaryColorBrush}" Foreground="Black"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>

                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}" Width="330">
                    <StackPanel>
                        <TextBlock Text="PERFORMANCE" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                        <TextBlock Text="Animation &amp; FPS" FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <CheckBox IsChecked="{Binding IsFpsLimited}" Style="{StaticResource PlayerCheckBoxStyle}" Margin="0,0,15,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Limit FPS" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ContentControl Style="{StaticResource HelpIconStyle}" ToolTip="Lowering the frame rate limit reduces overall system load.&#x0a;(Requires restart for UI animations)" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform X="-20"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFpsLimited}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-20" Duration="0:0:0.2"/>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Hidden}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Border Background="#2D2D30" CornerRadius="6" Height="36" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="-" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="32" Command="{Binding DecreaseFpsCommand}"/>
                                        <TextBlock Text="{Binding TargetFps}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Width="36" TextAlignment="Center"/>
                                        <Button Content="+" Style="{StaticResource SettingsActionBtn}" Background="Transparent" Width="32" Command="{Binding IncreaseFpsCommand}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding IsOptimizedWindowModeEnabled}" Style="{StaticResource PlayerCheckBoxStyle}" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Optimized Mode" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentControl Style="{StaticResource HelpIconStyle}" ToolTip="Disables borders transparency to completely remove CPU load.&#x0a;Rounded app corners may not look as intended.&#x0a;On Windows 10 and earlier, corners will appear square.&#x0a;(Requires restart)" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}" Width="330">
                    <StackPanel>
                        <TextBlock Text="GENERAL" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                        <CheckBox Content="Show Splash Screen on Startup" IsChecked="{Binding ShowSplashScreen}" Style="{DynamicResource PlayerCheckBoxStyle}" FontSize="15" Margin="0,0,0,20"/>

