                      SelectedValuePath="Key" DisplayMemberPath="Value"
                      Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}" Width="330">

                    <Border.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{DynamicResource OnestFont}"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Resources>

                    <StackPanel>
                        <TextBlock Text="NOW PLAYING" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                        <CheckBox IsChecked="{Binding IsNowPlayingFluidBackgroundEnabled}" Style="{StaticResource PlayerCheckBoxStyle}" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Fluid Background" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentControl Style="{StaticResource HelpIconStyle}" ToolTip="Replaces the solid static background with a volumetric,&#x0a;shimmering fluid smoke. (Increases system load)"/>
                            </StackPanel>
