              ItemsSource="{Binding BottomPanelLayouts}" SelectedValue="{Binding SelectedBottomLayout}"
              SelectedValuePath="Key" DisplayMemberPath="Value"
              Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>
                        </StackPanel>

                        <TextBlock Text="Timer Display Mode" FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,10"/>
                        <ComboBox Height="36" Margin="0,0,0,20"
                  ItemsSource="{Binding TimeDisplayModes}" SelectedItem="{Binding TimeDisplayMode}"
                  Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>

                        <StackPanel IsEnabled="{Binding IsVuMeterStyleEnabled}">
                            <TextBlock Text="VU Meter Style" FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,10"/>
                            <ComboBox Height="36" Margin="0,0,0,20"
              ItemsSource="{Binding VuMeterStyles}" SelectedValue="{Binding SelectedVuMeterStyle}"
              SelectedValuePath="Key" DisplayMemberPath="Value"
              Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>
                        </StackPanel>

                        <StackPanel IsEnabled="{Binding IsBottomPanelAdvancedSettingsAllowed}">
                            <TextBlock Text="Control Style" FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,10"/>
                            <ComboBox Height="36" Margin="0,0,0,20"
                      ItemsSource="{Binding ControlStyles}" SelectedItem="{Binding SelectedControlStyle}"
