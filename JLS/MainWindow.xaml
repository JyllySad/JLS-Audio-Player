                                            <Button Style="{StaticResource AnimatedTextSidebarButtonStyle}" 
        ToolTip="Statistics &amp; Info" 
        Command="{Binding OpenInfoPanelCommand}" 
        Tag="Info"
        controls:SidebarHelper.ActiveValue="{Binding ActiveSidebarItem}"
