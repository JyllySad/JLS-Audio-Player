<Window x:Class="JLS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:vm="clr-namespace:JLS.ViewModels"
        xmlns:converters="clr-namespace:JLS.Converters"
        xmlns:views="clr-namespace:JLS.Views"
        xmlns:controls="clr-namespace:JLS.Controls"
        xmlns:prop="clr-namespace:JLS.Properties"
        Title="{Binding WindowTitle}" 
        Height="{Binding Source={x:Static prop:Settings.Default}, Path=WindowHeight, Mode=TwoWay}" 
        Width="{Binding Source={x:Static prop:Settings.Default}, Path=WindowWidth, Mode=TwoWay}" 
        MinHeight="680" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="/logoalphaicon.ico"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="7" CornerRadius="10" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:ColorToContrastBrushConverter x:Key="ColorToContrastBrushConverter"/>
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo" 
                         ProgressValue="{Binding WaveformProgress}" 
                         ProgressState="{Binding TaskbarProgressState}">
            <TaskbarItemInfo.ThumbButtonInfos>

                <ThumbButtonInfo Description="Repeat" 
                 Command="{Binding ToggleRepeatCommand}" 
                 ImageSource="{Binding RepeatIcon}" />

                <ThumbButtonInfo Description="Previous Track" 
                                 Command="{Binding PlayPrevCommand}" 
                                 ImageSource="{StaticResource TaskbarPrevIcon}" />

                <ThumbButtonInfo Description="{Binding PlayPauseDescription}" 
                                 Command="{Binding TogglePlayPauseCommand}" 
                                 ImageSource="{Binding PlayPauseIcon}" />

                <ThumbButtonInfo Description="Next Track" 
                                 Command="{Binding PlayNextCommand}" 
                                 ImageSource="{StaticResource TaskbarNextIcon}" />

                <ThumbButtonInfo Description="Shuffle" 
                 Command="{Binding ToggleShuffleCommand}" 
                 ImageSource="{Binding ShuffleIcon}" />

            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Border x:Name="AppBorder" CornerRadius="10" Background="#181818" BorderThickness="0" Margin="1" SizeChanged="AppBorder_SizeChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Rectangle Width="1" Height="1" Opacity="0.01" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="-999">
                <Rectangle.Effect>
                    <controls:FluidBackgroundEffect />
                </Rectangle.Effect>
            </Rectangle>

            <tb:TaskbarIcon x:Name="AppTaskbarIcon"
                        IconSource="/logoalphaicon.ico"
                        TrayMouseDoubleClick="AppTaskbarIcon_TrayMouseDoubleClick">

                <tb:TaskbarIcon.ToolTipText>
                    <MultiBinding StringFormat="JLS Audio Player&#x0a;{0}&#x0a;{1}">
                        <Binding Path="CurrentTrackName" TargetNullValue="No Track Playing" FallbackValue="No Track Playing"/>
                        <Binding Path="ArtistName"/>
                    </MultiBinding>
                </tb:TaskbarIcon.ToolTipText>

                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu Background="#252525" BorderBrush="#3F3F41" BorderThickness="0" Padding="0,0,0,4" MaxWidth="320">

                        <ContextMenu.Template>
                            <ControlTemplate TargetType="ContextMenu">
                                <Border Margin="12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Opacity="0.5" ShadowDepth="5" Direction="270" Color="Black"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#252525"/>
                                            <Setter Property="CornerRadius" Value="10"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                                    <Setter Property="CornerRadius" Value="14"/>
                                                    <Setter Property="BorderThickness" Value="0"/>

                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{Binding DarkColor.Color, FallbackValue=#121212}" Opacity="0.88"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="10"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                                        <Setter Property="CornerRadius" Value="14"/>
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#26FFFFFF" Offset="0.0" />
                                                                    <GradientStop Color="#0EFFFFFF" Offset="0.15" />
                                                                    <GradientStop Color="#0AFFFFFF" Offset="0.5" />
                                                                    <GradientStop Color="#0AFFFFFF" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Border ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                                            <Setter Property="CornerRadius" Value="14"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid x:Name="MenuRootGrid">
                                                <Grid.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Border Background="Black" 
                                                                    CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}" 
                                                                    Width="{Binding ActualWidth, ElementName=MenuRootGrid}" 
                                                                    Height="{Binding ActualHeight, ElementName=MenuRootGrid}"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Grid.OpacityMask>

                                                <Border IsHitTestVisible="False" CornerRadius="13" BorderThickness="1,1,1,0" Panel.ZIndex="10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="BorderBrush">
                                                                        <Setter.Value>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#88FFFFFF" Offset="0.0" />
                                                                                <GradientStop Color="#1AFFFFFF" Offset="0.15" />
                                                                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <StackPanel IsItemsHost="True" Margin="0,0,0,4"/>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Border>
                            </ControlTemplate>
                        </ContextMenu.Template>

                        <ContextMenu.Resources>

                            <Style TargetType="MenuItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Grid Margin="4,2">
                                                <Border x:Name="HoverLayer" Background="White" Opacity="0" CornerRadius="4"/>
                                                <Grid Margin="4,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Path x:Name="CheckMark" Grid.Column="0" Width="12" Height="12" 
                                                      Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" 
                                                      Fill="White" Stretch="Uniform" Visibility="Collapsed" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <ContentPresenter ContentSource="Icon" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <ContentPresenter ContentSource="Header" Grid.Column="2" Margin="4,0,16,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="Separator">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Separator">
                                            <Border Height="1" Background="#3F3F41" Margin="10,4"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContextMenu.Resources>

                        <MenuItem StaysOpenOnClick="True">
                            <MenuItem.Template>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border Margin="0" Padding="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding BottomPanelBackground, FallbackValue='#1A1A1C'}"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#3F3F41"/>
                                                <Setter Property="CornerRadius" Value="10,10,0,0"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
                                                        <Setter Property="CornerRadius" Value="14,14,0,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="AlbumArtContainer" Grid.Column="0" Width="48" Height="48">
                                                <Grid>
                                                    <Grid.OpacityMask>
                                                        <VisualBrush>
                                                            <VisualBrush.Visual>
                                                                <Border Background="Black" CornerRadius="6" Width="48" Height="48" CacheMode="BitmapCache" />
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Grid.OpacityMask>

                                                    <Border Background="#28282B" 
                Visibility="{Binding AlbumArt, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <Path Width="20" Height="20" Fill="#666666" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                                                    </Border>

                                                    <Border>
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border.Background>
                                                    </Border>

                                                    <Border x:Name="DarkOverlay" Background="Black" Opacity="0"/>

                                                    <Button x:Name="InfoBtn" Command="{Binding OpenTrackInfoFromTrayCommand}" Click="InfoBtn_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Opacity="0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding CurrentTrackName, TargetNullValue='No Track Playing', FallbackValue='No Track Playing'}" 
                                   Foreground="{Binding AdaptiveTextColor, FallbackValue='White'}" 
                                   FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding ArtistName}" 
                                   Foreground="{Binding AdaptiveTextColor, FallbackValue='#A0A0A0'}" Opacity="0.8" 
                                   FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter" SourceName="AlbumArtContainer">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="DarkOverlay" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetName="InfoBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave" SourceName="AlbumArtContainer">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="DarkOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetName="InfoBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>

                        <MenuItem Header="Shuffle Queue" IsCheckable="True" IsChecked="{Binding IsShuffleActive, Mode=TwoWay}" StaysOpenOnClick="True">
                            <MenuItem.Icon>
                                <Path Fill="White" Stretch="Uniform" Width="14" Height="14" Data="{StaticResource IconShuffleGeometry}"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Command="{Binding ToggleRepeatCommand}" StaysOpenOnClick="True">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="Repeat: Off"/>
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding RepeatMode}" Value="All">
                                            <Setter Property="Header" Value="Repeat: Queue"/>
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding RepeatMode}" Value="One">
                                            <Setter Property="Header" Value="Repeat: One Track"/>
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                            <MenuItem.Icon>
                                <Path Fill="White" Stretch="Uniform" Width="14" Height="14">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource IconRepeatGeometry}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RepeatMode}" Value="One">
                                                    <Setter Property="Data" Value="{StaticResource IconRepeatOneGeometry}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator/>

                        <MenuItem Header="Media Keys" IsCheckable="True" IsChecked="{Binding IsMediaKeysEnabled, Mode=TwoWay}" StaysOpenOnClick="True">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Global Hotkeys" IsCheckable="True" IsChecked="{Binding IsGlobalHotkeysEnabled, Mode=TwoWay}" StaysOpenOnClick="True">
                            <MenuItem.Icon>
                                <Path Fill="White" Stretch="Uniform" Width="14" Height="14" Data="M 174.8,685.2 C 144.4,678.8 118.9,664.4 97,641.5 79.4,623.1 67.2,601.4 60.3,576.4 56.7,563.3 56.7,563.3 56.7,369.3 c 0,-194 0,-194 3,-204.9 14.3,-51.8 53.4,-91.2 103.7,-104.4 20.7,-5.4 27.9,-5.6 218,-5.1 170.6,.4 184,.6 193.3,2.9 60.1,14.4 102.8,59.5 112.6,119 2,11.8 2.1,32.3 1.8,199.9 -.4,186.7 -.4,186.7 -4,199.8 -14.5,52.6 -54.4,92.3 -108.4,107.8 -10.7,3.1 -10.7,3.1 -200,3.3 -184.2,.3 -189.7,.2 -201.9,-2.4 z m 392.5,-47 c 27.9,-8.3 50.1,-26.6 62.1,-50.9 10.7,-21.7 9.9,-5.8 9.9,-210.7 0,-182.7 0,-182.7 -3.1,-193.3 -8.6,-29.6 -28.2,-52.9 -55.6,-66.1 -22.4,-10.8 -6,-10 -208,-10 -170.3,0 -180.5,.1 -188.6,2.4 C 146.1,120.5 118.8,148.1 108.5,186 106.1,194.9 106,202.9 106,377.3 c 0,204.1 -.7,188.3 9.9,210 13.9,28.2 42.2,48.5 74.1,53.1 2.2,.3 86.2,.5 186.7,.4 171.5,-.2 183.2,-.3 190.7,-2.6 z M 234,604.7 c -21.2,-4.7 -43.3,-16.7 -58.8,-32 -14.8,-14.7 -23.7,-29.1 -30.7,-50 -3.8,-11.3 -3.8,-11.3 -4.2,-145.3 -.4,-147 -.6,-142.3 7.6,-163.6 5.6,-14.6 13.4,-25.9 26.7,-39.1 C 188.2,161.3 202,152.6 220,146.4 232.7,142 232.7,142 372.7,142 c 140,0 140,0 152.7,4.4 17.8,6.2 30.6,13.9 43.6,26.1 12.9,12.2 22.8,26.4 28.4,41.1 8.2,21.2 8,16.8 8,160.1 0,148.7 .5,141.5 -11.3,165.6 -14.4,29.6 -38.8,51 -70.9,62.1 C 510,606 510,606 376,606.2 269,606.4 240.4,606.1 234,604.7 Z m 270.6,-46.8 c 25.7,-6.7 47.4,-28.9 52.6,-53.7 2.1,-9.9 2.1,-252 0,-261.9 -2.6,-12.7 -8.8,-23.6 -19.1,-33.8 -10.5,-10.4 -19,-15.5 -30.8,-18.6 -11.4,-3 -257.4,-3.1 -268.4,-.1 -12.6,3.4 -21.7,8.7 -31.6,18.6 -10.1,10.1 -15.1,18.8 -18.5,32 -3.1,11.9 -3.1,253.5 0,265.4 6.4,24.8 26.6,45.1 51.5,51.8 11,3 253,3 264.4,.1 z"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="OSD Popup" IsCheckable="True" IsChecked="{Binding IsOsdEnabled, Mode=TwoWay}" StaysOpenOnClick="True">
                            <MenuItem.Icon>
                                <Path Fill="White" Stretch="Uniform" Width="14" Height="14" Data="M 110.6,632.2 C 100.4,629.5 96.1,626.7 86.7,616.5 77.3,606.1 75,600.9 73.3,586.4 71.4,569.6 71.8,168.8 73.7,154.7 c 1.4,-10.1 5.1,-17.6 13.2,-26.9 4.8,-5.5 17.7,-13.9 24.1,-15.6 4.3,-1.2 68.8,-1.5 263,-1.2 257.3,.4 257.3,.4 265.6,4.2 13.5,6.2 25.8,20.7 29.5,34.8 1.5,5.7 3,410.5 1.5,434 -.6,9.7 -1.5,14.2 -4,19.1 -6.9,13.7 -18.2,23.7 -32.2,28.4 -9.4,3.2 -9.4,3.2 -262.3,3.1 -232.5,-.1 -253.6,-.3 -261.6,-2.4 z M 620.6,583.2 c 1.9,-1.9 2.1,-22.9 2.1,-211.3 0,-205.5 -.1,-209.2 -2.6,-210.6 -3.1,-1.7 -493.2,-1.9 -495.8,-.3 -.9,.6 -2.2,2.8 -2.7,5 -.6,2.1 -.9,29.4 -.8,60.6 .1,31.2 .3,123.4 .4,205 .1,146.5 .2,148.4 2.8,151 2.6,2.6 4.4,2.7 248.6,2.7 221.8,0 246.1,-.2 248,-2.1 z M 159.9,270.6 c -.8,-.5 -1.1,-14.5 -.9,-34.7 L 159.3,202 l 10,-.8 c 14.8,-1.2 231.1,-1.3 232.9,-.1 1.8,1.1 2.8,66.8 1.1,69.6 -.7,1.2 -29.5,1.5 -121.6,1.2 -66.3,-.2 -121.2,-.8 -121.9,-1.2 z"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Mini Player" IsCheckable="True" IsChecked="{Binding IsMiniPlayerEnabled, Mode=TwoWay}" IsEnabled="{Binding IsMinimizeToTrayEnabled}" Click="TrayMiniPlayer_Click" StaysOpenOnClick="True">
                            <MenuItem.Icon>
                                <Path Fill="White" Stretch="Uniform" Width="14" Height="14" Data="M19 7h-8v6h8V7zm2-4H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16.01H3V4.98h18v14.03z"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator/>

                        <MenuItem x:Name="TrayOpenMenuItem" Header="Open Player" Click="TrayOpen_Click" Visibility="Collapsed">
                            <MenuItem.Icon>
