                                    <Condition Binding="{Binding SelectedTitleBarColorMode}" Value="FromCoverInNowPlaying"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Margin" Value="0,0,0,0"/>
                            </MultiDataTrigger>

                            <DataTrigger Binding="{Binding IsCleanModeEnabled}" Value="True">
                                <Setter Property="Margin" Value="0,0,0,0"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Visibility, ElementName=TitleBarContainer}" Value="Collapsed">
                                <Setter Property="Margin" Value="0,0,0,0"/>
                                <Setter Property="CornerRadius" Value="0"/>
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <views:NowPlayingView>
                    <views:NowPlayingView.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
                    </views:NowPlayingView.LayoutTransform>
                </views:NowPlayingView>
            </Border>
            <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="300" Background="{Binding DarkColor}" ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>

                        <Setter Property="Margin" Value="0,32,0,0"/>
                        <Setter Property="CornerRadius" Value="0,0,10,10"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsCleanModeEnabled}" Value="True">
                                <Setter Property="Margin" Value="0,0,0,0"/>
                                <Setter Property="CornerRadius" Value="10"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsOverlayVisualizerVisible}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <views:VisualizerControl Background="Transparent" />
            </Border>

            <Grid DataContext="{Binding FileBrowser}" Grid.Row="0" Grid.RowSpan="10" Panel.ZIndex="1500" x:Name="FullCoverOverlay">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullCoverVisible}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="#F2080808">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding HideFullCoverCommand}"/>
                    </Border.InputBindings>
                </Border>

                <Image Source="{Binding FullAlbumCover}" Stretch="Uniform" Margin="60" 
           VerticalAlignment="Center" HorizontalAlignment="Center" 
           RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                    </Image.Effect>
                    <Image.RenderTransformOrigin>
                        <Point X="0.5" Y="0.5"/>
                    </Image.RenderTransformOrigin>
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                    </Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFullCoverVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Grid>

            <Grid DataContext="{Binding SavedAlbumsViewModel}" Grid.Row="0" Grid.RowSpan="10" Panel.ZIndex="1500" x:Name="FullCoverOverlayAlbums">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullCoverVisible}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="#F2080808">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding HideFullCoverCommand}"/>
                    </Border.InputBindings>
                </Border>

                <Image Source="{Binding FullAlbumCover}" Stretch="Uniform" Margin="60" 
                       VerticalAlignment="Center" HorizontalAlignment="Center" 
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                    </Image.Effect>
                    <Image.RenderTransformOrigin>
                        <Point X="0.5" Y="0.5"/>
                    </Image.RenderTransformOrigin>
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                    </Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFullCoverVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Grid>

            <views:TrackInfoView DataContext="{Binding TrackInfo}" Grid.Row="0" Grid.RowSpan="10" Panel.ZIndex="999"/>

            <views:BulkTrackInfoView DataContext="{Binding BulkTrackInfo}" Grid.Row="0" Grid.RowSpan="10" Panel.ZIndex="2000" />

            <Grid Grid.Row="0" Grid.RowSpan="10" Background="#B2000000" Panel.ZIndex="2500"
              UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlaylistsViewModel.IsRenameDialogOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsHitTestVisible">
                                                <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                            </BooleanAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsHitTestVisible">
                                                <DiscreteBooleanKeyFrame KeyTime="0:0:0:0.15" Value="False"/>
                                            </BooleanAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border CornerRadius="12" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#252528"/>
                            <Setter Property="BorderBrush" Value="#3F3F46"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#55FFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#15FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#EE1E1E1E" Offset="0.0"/>
                                                <GradientStop Color="#CC1E1E1E" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.7" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Edit Track Info" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,25"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="TITLE" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                                <TextBox Text="{Binding PlaylistsViewModel.EditTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmoothTextBoxStyle}" Margin="0,0,0,18"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TRACK #" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                                <TextBox Text="{Binding PlaylistsViewModel.EditTrackNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmoothTextBoxStyle}" Margin="0,0,0,18" MaxLength="4"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="ARTIST" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                        <TextBox Text="{Binding PlaylistsViewModel.EditArtist, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmoothTextBoxStyle}" Margin="0,0,0,18"/>

                        <TextBlock Text="ALBUM" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                        <TextBox Text="{Binding PlaylistsViewModel.EditAlbum, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmoothTextBoxStyle}" Margin="0,0,0,18"/>

                        <TextBlock Text="YEAR" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                        <TextBox Text="{Binding PlaylistsViewModel.EditYear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmoothTextBoxStyle}" Margin="0,0,0,18" />

                        <TextBlock Text="GENRE" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                        <TextBox Text="{Binding PlaylistsViewModel.EditGenre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmoothTextBoxStyle}" Margin="0,0,0,20" />

                        <StackPanel Orientation="Horizontal" Margin="2,0,0,25">
                            <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" Foreground="#666" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="These changes are visual only and do not modify the original tags." 
                                   Foreground="#777" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Cancel" Command="{Binding PlaylistsViewModel.CancelRenameCommand}" 
                                Style="{StaticResource SmoothActionButtonStyle}" Height="40"/>

                            <Button Grid.Column="2" Command="{Binding PlaylistsViewModel.ResetToDefaultCommand}" 
                                ToolTip="Restore original tags from file"
                                Style="{StaticResource SmoothActionButtonStyle}" Height="40" Width="40">
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="16" 
                                       Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <Button Grid.Column="4" Content="Save Changes" Command="{Binding PlaylistsViewModel.ConfirmRenameCommand}" 
                                Background="{Binding PlaylistsViewModel.SelectedPlaylist.ColorHex, Converter={StaticResource HexToBrushConverter}}" 
                                Foreground="Black" FontWeight="Bold" Style="{StaticResource SmoothActionButtonStyle}" Height="40"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="0" Grid.RowSpan="10" Background="#B2000000" Panel.ZIndex="2500"
                  UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SavedAlbumsViewModel.IsRenameDialogOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsHitTestVisible">
                                                <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                            </BooleanAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsHitTestVisible">
                                                <DiscreteBooleanKeyFrame KeyTime="0:0:0.15" Value="False"/>
                                            </BooleanAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border CornerRadius="12" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#252528"/>
                            <Setter Property="BorderBrush" Value="#3F3F46"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#55FFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#15FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#EE1E1E1E" Offset="0.0"/>
                                                <GradientStop Color="#CC1E1E1E" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.7" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Edit Album Info" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,25"/>

                        <TextBlock Text="ALBUM TITLE" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                        <TextBox Text="{Binding SavedAlbumsViewModel.EditTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmoothTextBoxStyle}" Margin="0,0,0,18" />

                        <TextBlock Text="ARTIST" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                        <TextBox Text="{Binding SavedAlbumsViewModel.EditArtist, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmoothTextBoxStyle}" Margin="0,0,0,18" />

                        <TextBlock Text="RELEASE YEAR" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                        <TextBox Text="{Binding SavedAlbumsViewModel.EditYear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmoothTextBoxStyle}" Margin="0,0,0,30" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Cancel" Command="{Binding SavedAlbumsViewModel.CancelRenameCommand}" 
                                    Style="{StaticResource SmoothActionButtonStyle}" Height="40"/>

                            <Button Grid.Column="2" Content="Save Changes" Command="{Binding SavedAlbumsViewModel.ConfirmRenameCommand}" 
            Style="{StaticResource SmoothActionButtonStyle}" Height="40"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <views:EasterEggView DataContext="{Binding EasterEggVM}" 
                                 Grid.Row="0" 
                                 Grid.RowSpan="2" 
                                 Panel.ZIndex="1000"
                                 Visibility="{Binding IsEasterEggVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <views:PlayHistoryView DataContext="{Binding PlayHistoryVM}" 
                       Grid.Row="0" Grid.RowSpan="10" Panel.ZIndex="3000" />

        </Grid>
    </Border>
</Window>