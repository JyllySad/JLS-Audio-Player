                                        </StackPanel>
                            </Border>

                                    <Grid Grid.Column="1" Margin="0">

                                        <views:FileBrowserView DataContext="{Binding FileBrowser}">
                                            <views:FileBrowserView.Style>
                                                <Style TargetType="UserControl" BasedOn="{StaticResource SmoothTransitionStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsExplorerActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </views:FileBrowserView.Style>
                                        </views:FileBrowserView>

                                        <views:PlaylistsView DataContext="{Binding PlaylistsViewModel}">
                                            <views:PlaylistsView.Style>
                                                <Style TargetType="UserControl" BasedOn="{StaticResource SmoothTransitionStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsPlaylistsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </views:PlaylistsView.Style>
                                        </views:PlaylistsView>

                                        <views:SavedAlbumsView DataContext="{Binding SavedAlbumsViewModel}">
                                            <views:SavedAlbumsView.Style>
                                                <Style TargetType="UserControl" BasedOn="{StaticResource SmoothTransitionStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSavedAlbumsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </views:SavedAlbumsView.Style>
                                        </views:SavedAlbumsView>

                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,-1,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#181818" />

                                    <Border Grid.Column="1" Background="#1E1E1E" />
                                </Grid>

                                <Border Panel.ZIndex="100">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Grid.Row" Value="1"/>
                                            <Setter Property="Grid.RowSpan" Value="1"/>
                                            <Setter Property="Margin" Value="0,-1,0,0"/>
                                            <Setter Property="CornerRadius" Value="10,10,0,0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="{Binding BottomPanelBackground}"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                                    <Setter Property="Grid.Row" Value="0"/>
                                                    <Setter Property="Grid.RowSpan" Value="2"/>
                                                    <Setter Property="VerticalAlignment" Value="Bottom"/>

                                                    <Setter Property="Margin" Value="20,0,20,20"/>
                                                    <Setter Property="CornerRadius" Value="16"/>

                                                    <Setter Property="BorderThickness" Value="0"/>

                                                    <Setter Property="BorderBrush">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#70FFFFFF" Offset="0.0" />
                                                                <GradientStop Color="#00FFFFFF" Offset="0.2" />
                                                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>

                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect RenderingBias="Performance" BlurRadius="25" ShadowDepth="12" Opacity="0.55" Direction="270" Color="Black"/>
                                                        </Setter.Value>
                                                    </Setter>

                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{Binding BottomPanelBackground.Color, FallbackValue=#181818}" Opacity="0.82"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border ClipToBounds="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="10,10,0,0"/>
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                            <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                                            <GradientStop Color="#00FFFFFF" Offset="0.44" />
                                                            <GradientStop Color="#0EFFFFFF" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                                        <Setter Property="CornerRadius" Value="16"/>
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#2AFFFFFF" Offset="0.0" />
                                                                    <GradientStop Color="#12FFFFFF" Offset="0.15" />
                                                                    <GradientStop Color="#10FFFFFF" Offset="0.2" />
                                                                    <GradientStop Color="#10FFFFFF" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>

                                            <Border IsHitTestVisible="False" Margin="0,0,0,0" CornerRadius="15" BorderThickness="1,1,1,0" Panel.ZIndex="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="BorderBrush">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="#70FFFFFF" Offset="0.0" />
                                                                            <GradientStop Color="#00FFFFFF" Offset="0.2" />
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <Grid Margin="10,0" Height="170" VerticalAlignment="Bottom">

                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMinimalBottomPanelEnabled}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="270"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="150" Height="150" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.OpacityMask>
                                                            <VisualBrush>
                                                                <VisualBrush.Visual>
                                                                    <Border Background="Black" CornerRadius="8" Width="150" Height="150" CacheMode="BitmapCache" />
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Grid.OpacityMask>

                                                        <Border Background="#222" Visibility="{Binding AlbumArt, Converter={StaticResource NullToVisibilityConverter}}">
                                                            <TextBlock Text="&#xE189;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <Image Source="{Binding AlbumArt, NotifyOnTargetUpdated=True}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Triggers>
                                                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.4">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Image.Triggers>
                                                        </Image>

                                                        <Button Command="{Binding ShowNowPlayingCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid>
                                                                        <Border x:Name="DarkOverlay" Background="Black" Opacity="0"/>

                                                                        <TextBlock x:Name="ExpandIcon" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" 
                                   FontSize="32" Foreground="White" Opacity="0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <TextBlock.RenderTransform>
                                                                                <TranslateTransform Y="10"/>
                                                                            </TextBlock.RenderTransform>
                                                                        </TextBlock>
                                                                    </Grid>

                                                                    <ControlTemplate.Triggers>
                                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="DarkOverlay" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.2"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="ExpandIcon" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.2"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="ExpandIcon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2" DecelerationRatio="0.8"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="DarkOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="ExpandIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                                                    <DoubleAnimation Storyboard.TargetName="ExpandIcon" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="10" Duration="0:0:0.2" AccelerationRatio="0.8"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">

                                                <StackPanel.Resources>
                                                        <Style x:Key="AnimatedTextStyle" TargetType="FrameworkElement">
                                                            <Setter Property="TextElement.FontFamily" Value="{StaticResource OnestFont}"/>
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                <TranslateTransform Y="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" Duration="0:0:0.3"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                                                 From="8" To="0" Duration="0:0:0.35">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Resources>

                                                <Grid ClipToBounds="True" Background="Transparent" Margin="0,0,0,0" MouseEnter="Marquee_MouseEnter" MouseLeave="Marquee_MouseLeave">
                                                    <TextBlock Style="{StaticResource AnimatedTextStyle}"
                                                       Text="{Binding CurrentTrackName, NotifyOnTargetUpdated=True}" 
                                                       TargetUpdated="Marquee_TargetUpdated"
                                                       FontSize="22" FontWeight="Bold" Foreground="{Binding AdaptiveTextColor}" 
                                                       TextTrimming="CharacterEllipsis"/>
                                                    <Canvas Visibility="Hidden" IsHitTestVisible="False">
                                                        <TextBlock Text="{Binding CurrentTrackName}" 
                                                           FontSize="22" FontWeight="Bold" Foreground="{Binding AdaptiveTextColor}">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform X="0"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                    </Canvas>
                                                </Grid>

                                                <Grid ClipToBounds="True" Background="Transparent" MouseEnter="Marquee_MouseEnter" MouseLeave="Marquee_MouseLeave">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Margin" Value="0,4,0,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHorizontalVolumeEnabled}" Value="True">
                                                                    <Setter Property="Margin" Value="0,1,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <TextBlock Style="{StaticResource AnimatedTextStyle}"
                                                       Text="{Binding ArtistName, NotifyOnTargetUpdated=True}" 
                                                       TargetUpdated="Marquee_TargetUpdated"
                                                       FontSize="16" FontWeight="SemiBold" Foreground="{Binding AdaptiveTextColor}" 
                                                       Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                                    <Canvas Visibility="Hidden" IsHitTestVisible="False" Opacity="0.8">
                                                        <TextBlock Text="{Binding ArtistName}" 
                                                           FontSize="16" FontWeight="SemiBold" Foreground="{Binding AdaptiveTextColor}">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform X="0"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                    </Canvas>
                                                </Grid>

                                                <Grid ClipToBounds="True" Background="Transparent" MouseEnter="Marquee_MouseEnter" MouseLeave="Marquee_MouseLeave">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Margin" Value="0,2,0,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHorizontalVolumeEnabled}" Value="True">
                                                                    <Setter Property="Margin" Value="0,0,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <TextBlock Style="{StaticResource AnimatedTextStyle}"
                                                       Text="{Binding AlbumName, NotifyOnTargetUpdated=True}" 
                                                       TargetUpdated="Marquee_TargetUpdated"
                                                       FontSize="14" FontWeight="SemiBold" Foreground="{Binding AdaptiveTextColor}" 
                                                       Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                                    <Canvas Visibility="Hidden" IsHitTestVisible="False" Opacity="0.6">
                                                        <TextBlock Text="{Binding AlbumName}" 
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{Binding AdaptiveTextColor}">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform X="0"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                    </Canvas>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Opacity="0.9">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Margin" Value="0,10,0,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHorizontalVolumeEnabled}" Value="True">
                                                                    <Setter Property="Margin" Value="0,4,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <StackPanel.Resources>
                                                            <Style TargetType="Border" BasedOn="{StaticResource AnimatedTextStyle}">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                                <Setter Property="Padding" Value="6,3"/>
                                                                <Setter Property="Margin" Value="0,0,5,0"/>
                                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="BorderBrush" Value="Transparent"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AdaptiveTextColor.Color}" Value="#FF000000">
                                                                        <Setter Property="Background" Value="#1A000000"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Setter Property="BorderBrush">
                                                                            <Setter.Value>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                    <GradientStop Color="#55FFFFFF" Offset="0.0" />
                                                                                    <GradientStop Color="#10FFFFFF" Offset="0.5" />
                                                                                    <GradientStop Color="#15FFFFFF" Offset="1.0" />
                                                                                </LinearGradientBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Setter Property="Background">
                                                                            <Setter.Value>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                    <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
                                                                                    <GradientStop Color="#08FFFFFF" Offset="1.0"/>
                                                                                </LinearGradientBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>

                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsGlassModeEnabled}" Value="True"/>
                                                                            <Condition Binding="{Binding AdaptiveTextColor.Color}" Value="#FF000000"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="BorderBrush">
                                                                            <Setter.Value>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                    <GradientStop Color="#44000000" Offset="0.0" />
                                                                                    <GradientStop Color="#10000000" Offset="0.5" />
                                                                                    <GradientStop Color="#15000000" Offset="1.0" />
                                                                                </LinearGradientBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Setter Property="Background">
                                                                            <Setter.Value>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                    <GradientStop Color="#1A000000" Offset="0.0"/>
                                                                                    <GradientStop Color="#08000000" Offset="1.0"/>
                                                                                </LinearGradientBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="FontSize" Value="12"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            <Setter Property="Foreground" Value="{Binding AdaptiveTextColor}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AdaptiveTextColor.Color}" Value="#FF000000">
                                                                    <Setter Property="Foreground" Value="{Binding AdaptiveTextColor}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Resources>

                                                    <Border Visibility="{Binding IsAudioFormatVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding AudioFormat, NotifyOnTargetUpdated=True}"/>
                                                    </Border>

                                                    <Border Visibility="{Binding IsAudioSampleRateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding AudioSampleRate, NotifyOnTargetUpdated=True}"/>
                                                    </Border>

                                                        <Border Visibility="{Binding IsAudioBitDepthVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding AudioBitDepth, NotifyOnTargetUpdated=True}"/>
                                                        </Border>

                                                        <Border Margin="0" Visibility="{Binding IsAudioBitrateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding AudioBitrate, NotifyOnTargetUpdated=True}"/>
                                                        </Border>
                                                    </StackPanel>

                                                <Button Command="{Binding ToggleTimeDisplayModeCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" 
        Padding="0" HorizontalAlignment="Left"
        ToolTip="Toggle Time Mode" ToolTipService.Placement="Top">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Margin" Value="0,10,0,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHorizontalVolumeEnabled}" Value="True">
                                                                    <Setter Property="Margin" Value="0,4,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="{Binding TimeDisplay}" 
                                                       FontSize="16" 
                                                       FontFamily="Century Gothic" 
                                                       FontWeight="Bold"
                                                       Foreground="{Binding AdaptiveTextColor}" 
                                                       Opacity="0.8"/>
                                                </Button>

                                                <Grid Margin="0,2,0,0" Width="200" HorizontalAlignment="Left"
      Visibility="{Binding IsHorizontalVolumeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Cursor="Hand" 
            VerticalAlignment="Center" Margin="1,0,2,0" Click="MuteButton_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                            <Viewbox Width="20" Height="20" Opacity="0.8">
                                                                <Grid Width="684" Height="684">
                                                                    <Path Data="{Binding Volume, Converter={StaticResource VolumeToSpeakerIconConverter}}" 
              Fill="{Binding AdaptiveTextColor}" 
              Stretch="None" 
              HorizontalAlignment="Left" 
              VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Viewbox>
                                                        </Button>

                                                    <Slider Grid.Column="1" x:Name="VolumeSliderHorizontal"
            Orientation="Horizontal"
            Minimum="0.0" Maximum="1.0" 
            Value="{Binding Volume, Mode=TwoWay}"
            Style="{StaticResource HorizontalVolumeSliderStyle}"
            VerticalAlignment="Center"
            ValueChanged="VolumeSlider_ValueChanged"
            MouseEnter="VolumeSlider_MouseEnter"
            MouseLeave="VolumeSlider_MouseLeave"
            PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown"
            PreviewMouseMove="VolumeSlider_PreviewMouseMove"
            PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"
            PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"/>

                                                        <Popup x:Name="VolumePopupHorizontal" PlacementTarget="{Binding ElementName=VolumeSliderHorizontal}" Placement="Right" 
       HorizontalOffset="4" VerticalOffset="-6" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True" IsHitTestVisible="False" IsOpen="False">
                                                            <Border Style="{StaticResource PopupGlassStyle99}" CornerRadius="8" Padding="4,4" Width="50" Margin="0">
                                                                <TextBlock Foreground="White" FontSize="14" FontWeight="Bold" 
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Text="{Binding Volume, StringFormat='{}{0:P0}'}"/>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>

                                            </StackPanel>
                                           <Grid Grid.Column="2" Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Column0Width}"/>
                                            <ColumnDefinition Width="{Binding Column1Width}"/>
                                            <ColumnDefinition Width="{Binding Column2Width}"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="{Binding VolumeColumn}" Margin="5,0,5,0" Height="150" VerticalAlignment="Center"
                                              Visibility="{Binding IsHorizontalVolumeEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                                    <Slider Grid.Row="0" x:Name="VolumeSlider" Orientation="Vertical" Width="16" Minimum="0.0" Maximum="1.0" Margin="0,0,0,8" 
                                                    Value="{Binding Volume, Mode=TwoWay}" Style="{StaticResource VerticalVolumeSliderStyle}" VerticalAlignment="Stretch"
                                                    ValueChanged="VolumeSlider_ValueChanged" PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="VolumeSlider_PreviewMouseMove" PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"
                                                    PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp" MouseEnter="VolumeSlider_MouseEnter" MouseLeave="VolumeSlider_MouseLeave"/>

                                                        <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeSlider}" Placement="Left" 
       HorizontalOffset="-10" VerticalOffset="128" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True" IsHitTestVisible="False" IsOpen="False">
                                                            <Border Style="{StaticResource PopupGlassStyle99}" CornerRadius="8" Padding="4,4" Width="50" Margin="0">
                                                                <TextBlock x:Name="VolumePercentText" Foreground="White" FontSize="14" FontWeight="Bold" 
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Text="{Binding Volume, StringFormat='{}{0:P0}'}"/>
                                                            </Border>
                                                        </Popup>

                                                        <Button Grid.Row="1" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="MuteButton_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent"><ContentPresenter/></Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                            <Viewbox Width="20" Height="20" Opacity="0.7">
                                                                <Grid Width="684" Height="684">
                                                                    <Path Data="{Binding Volume, Converter={StaticResource VolumeToSpeakerIconConverter}}" 
              Fill="{Binding AdaptiveTextColor}" 
              Stretch="None" 
              HorizontalAlignment="Left" 
              VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Viewbox>
                                                        </Button>
                                        </Grid>

                                                <Grid Grid.Column="{Binding VuMeterColumn}" Margin="10,0,0,0" Height="150" VerticalAlignment="Center"
      Visibility="{Binding IsVuMeterVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedVuMeterStyle}" Value="Split">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="40"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0" Grid.Column="0" Margin="4,0,4,2">
                                                            <ProgressBar Value="{Binding VuLeft}" Foreground="{Binding LightColor}" Background="{Binding DarkColor}" BorderThickness="0">
                                                                <ProgressBar.LayoutTransform>
                                                                    <RotateTransform Angle="-90"/>
                                                                </ProgressBar.LayoutTransform>
                                                                <ProgressBar.Template>
                                                                    <ControlTemplate TargetType="ProgressBar">
                                                                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4">
                                                                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ProgressBar.Template>
                                                            </ProgressBar>
                                                        </Grid>

                                                        <Grid Grid.Row="0" Grid.Column="1" Margin="4,0,4,2">
                                                            <ProgressBar Value="{Binding VuRight}" Foreground="{Binding LightColor}" Background="{Binding DarkColor}" BorderThickness="0">
                                                                <ProgressBar.LayoutTransform>
                                                                    <RotateTransform Angle="-90"/>
                                                                </ProgressBar.LayoutTransform>
                                                                <ProgressBar.Template>
                                                                    <ControlTemplate TargetType="ProgressBar">
                                                                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4">
                                                                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ProgressBar.Template>
                                                            </ProgressBar>
                                                        </Grid>

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="L" FontSize="18" FontWeight="Bold" Foreground="{Binding AdaptiveTextColor}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform Y="3"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="R" FontSize="18" FontWeight="Bold" Foreground="{Binding AdaptiveTextColor}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform Y="3"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                    </Grid>

                                                    <Border Background="{Binding DarkColor}" Width="40" CornerRadius="6">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedVuMeterStyle}" Value="Minimal">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="2"/>
                                                                <ColumnDefinition Width="1*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <ProgressBar Grid.Column="0" Value="{Binding VuLeft}" Foreground="{Binding LightColor}" Background="Transparent" BorderThickness="0">
                                                                <ProgressBar.LayoutTransform>
                                                                    <RotateTransform Angle="-90"/>
                                                                </ProgressBar.LayoutTransform>
                                                                <ProgressBar.Template>
                                                                    <ControlTemplate TargetType="ProgressBar">
                                                                        <Border x:Name="PART_Track" Background="Transparent">
                                                                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="6,6,0,0" HorizontalAlignment="Left"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ProgressBar.Template>
                                                            </ProgressBar>

                                                            <TextBlock Grid.Column="0" Text="L" FontSize="14" FontWeight="SemiBold" Foreground="{Binding AdaptiveTextColor}" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>

                                                            <ProgressBar Grid.Column="2" Value="{Binding VuRight}" Foreground="{Binding LightColor}" Background="Transparent" BorderThickness="0">
                                                                <ProgressBar.LayoutTransform>
                                                                    <RotateTransform Angle="-90"/>
                                                                </ProgressBar.LayoutTransform>
                                                                <ProgressBar.Template>
                                                                    <ControlTemplate TargetType="ProgressBar">
                                                                        <Border x:Name="PART_Track" Background="Transparent">
                                                                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="0,0,6,6" HorizontalAlignment="Left"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ProgressBar.Template>
                                                            </ProgressBar>

                                                            <TextBlock Grid.Column="2" Text="R" FontSize="14" FontWeight="SemiBold" Foreground="{Binding AdaptiveTextColor}" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>

                                                <Grid Grid.Column="{Binding WaveformColumn}" Margin="10,0,5,0">
                                            
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedControlStyle}" Value="Waveform">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <Border Background="Transparent" CornerRadius="4">
                                                                <Grid x:Name="WaveformArea" 
      SizeChanged="WaveformArea_SizeChanged" 
      Background="Transparent"
      MouseMove="WaveformArea_MouseMove" 
      MouseLeave="WaveformArea_MouseLeave">

                                                                    <controls:WaveformControl WaveformRenderStyle="{Binding SelectedWaveformStyle}" 
                          LeftPeaks="{Binding LeftWaveform, NotifyOnTargetUpdated=True}" 
                          RightPeaks="{Binding RightWaveform}" 
                          Progress="{Binding WaveformProgress}" 
                          PlayedBrush="{Binding LightColor}" 
                          Margin="0,0">
                                                                        <controls:WaveformControl.Style>
                                                                            <Style TargetType="controls:WaveformControl">
                                                                                <Setter Property="UnplayedBrush" Value="{Binding DarkColor}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsGlassModeEnabled}" Value="True">
                                                                                        <Setter Property="UnplayedBrush">
                                                                                            <Setter.Value>
                                                                                                <SolidColorBrush Color="{Binding DarkColor.Color}" Opacity="0.65"/>
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </controls:WaveformControl.Style>
                                                                        <controls:WaveformControl.OpacityMask>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                <GradientStop Color="Black" Offset="0.0" />
                                                                                <GradientStop x:Name="WaveformMaskEdge" Color="Black" Offset="0.0" />
                                                                                <GradientStop x:Name="WaveformMaskTail" Color="Transparent" Offset="0.05" />
                                                                            </LinearGradientBrush>
                                                                        </controls:WaveformControl.OpacityMask>
                                                                        <controls:WaveformControl.Triggers>
                                                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                                <BeginStoryboard>
                                                                                    <Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                                                                        <DoubleAnimation Storyboard.TargetName="WaveformMaskEdge" Storyboard.TargetProperty="Offset" From="0.0" To="1.0" Duration="0:0:0.5">
                                                                                            <DoubleAnimation.EasingFunction>
                                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                                            </DoubleAnimation.EasingFunction>
                                                                                        </DoubleAnimation>
                                                                                        <DoubleAnimation Storyboard.TargetName="WaveformMaskTail" Storyboard.TargetProperty="Offset" From="0.05" To="1.05" Duration="0:0:0.5">
                                                                                            <DoubleAnimation.EasingFunction>
                                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                                            </DoubleAnimation.EasingFunction>
                                                                                        </DoubleAnimation>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </EventTrigger>
                                                                        </controls:WaveformControl.Triggers>
                                                                    </controls:WaveformControl>

                                                                    <Slider x:Name="TrackSliderWaveform" 
            Minimum="0" 
            Maximum="{Binding TotalDuration}" 
            Value="{Binding CurrentPosition, Mode=TwoWay}" 
            VerticalAlignment="Stretch" 
            IsMoveToPointEnabled="False" 
            Cursor="Hand" 
            Opacity="0"
            ValueChanged="TrackSliderWaveform_ValueChanged"
            PreviewMouseLeftButtonDown="TrackSlider_PreviewMouseLeftButtonDown"
            PreviewMouseMove="TrackSlider_PreviewMouseMove"
            PreviewMouseLeftButtonUp="TrackSlider_PreviewMouseLeftButtonUp">
                                                                        <Slider.Style>
                                                                            <Style TargetType="Slider">
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Opacity" Value="0.3"/>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Slider.Style>
                                                                    </Slider>

                                                                    <Border x:Name="WaveformCaretBubble" MinWidth="45" CornerRadius="4" Padding="6,2" Height="22" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False" Margin="0,-25,0,0">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                                                                        </Border.Effect>
                                                                        <Border.Style>
                                                                            <Style TargetType="Border" BasedOn="{StaticResource PopupGlassStyleCC}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Setter Property="Opacity" Value="0"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=WaveformArea}" Value="True">
                                                                                        <DataTrigger.EnterActions>
                                                                                            <BeginStoryboard>
                                                                                                <Storyboard>
                                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                                                                </Storyboard>
                                                                                            </BeginStoryboard>
                                                                                        </DataTrigger.EnterActions>
                                                                                        <DataTrigger.ExitActions>
                                                                                            <BeginStoryboard>
                                                                                                <Storyboard>
                                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}"/>
                                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                                </Storyboard>
                                                                                            </BeginStoryboard>
                                                                                        </DataTrigger.ExitActions>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Border.RenderTransform>
                                                                            <TranslateTransform X="0" x:Name="WaveformCaretTransform"/>
                                                                        </Border.RenderTransform>
                                                                        <TextBlock Text="{Binding CurrentTimeOnly}" Typography.NumeralAlignment="Tabular" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </Border>

                                                                    <Border x:Name="WaveformHoverBubble" MinWidth="45" Style="{StaticResource PopupGlassStyleCC}" CornerRadius="4" Padding="6,2" Height="22" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False" Margin="-23,-25,0,0" Opacity="0">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                                                                        </Border.Effect>
                                                                        <Border.RenderTransform>
                                                                            <TranslateTransform X="0" x:Name="WaveformHoverTransform"/>
                                                                        </Border.RenderTransform>
                                                                        <TextBlock x:Name="WaveformHoverText" Text="00:00" Typography.NumeralAlignment="Tabular" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </Border>

                                                                </Grid>
                                                            </Border>

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="True">

                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Opacity" Value="1"/>

                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsAutoHideControlsEnabled}" Value="True"/>
                                                                                <Condition Binding="{Binding IsPlaying}" Value="True"/>
                                                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=IsMouseOver}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>

                                                                            <MultiDataTrigger.EnterActions>
                                                                                <BeginStoryboard>
                                                                                    <Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                                                                            <DoubleAnimation.EasingFunction>
                                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                                            </DoubleAnimation.EasingFunction>
                                                                                        </DoubleAnimation>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </MultiDataTrigger.EnterActions>

                                                                            <MultiDataTrigger.ExitActions>
                                                                                <BeginStoryboard>
                                                                                    <Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                                                                            <DoubleAnimation.EasingFunction>
                                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                                            </DoubleAnimation.EasingFunction>
                                                                                        </DoubleAnimation>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
